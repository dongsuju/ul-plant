import os
from minio import Minio
c = Minio('rag-minio:9000', access_key='rag_flow', secret_key='infini_rag_flow', secure=False)
root='/ragflow/logs/i6821dump'
n=0; total=0
with open('/ragflow/logs/i6821_manifest.txt','w') as mf:
    for b in c.list_buckets():
        for o in c.list_objects(b.name, recursive=True):
            p=os.path.join(root, b.name, o.object_name)
            os.makedirs(os.path.dirname(p), exist_ok=True)
            try:
                c.fget_object(b.name, o.object_name, p)
                n+=1; total+=o.size
                mf.write(f"{b.name}\t{o.object_name}\t{o.size}\tOK\n")
            except Exception as e:
                mf.write(f"{b.name}\t{o.object_name}\t{o.size}\tERR {str(e)[:80]}\n")
print("DONE files=%d bytes=%d"%(n,total))

