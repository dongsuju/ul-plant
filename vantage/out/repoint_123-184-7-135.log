# æ£€æŸ¥ç¬¬6è¡Œæ˜¯å¦åŒ…å« GRUB_DEFAULT=
if grep -q "^GRUB_DEFAULT=" "$grub_config"; then
    # æ£€æŸ¥ç¬¬6è¡Œæ˜¯å¦æ˜¯GRUB_DEFAULT=å¼€å¤´
    current_grub_default=$(sed -n '6p' "$grub_config")
