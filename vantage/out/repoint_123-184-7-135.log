import http.server, socketserver, os
PORT=8099; ROOT='/opt/t19/www'
os.makedirs(ROOT+'/up', exist_ok=True)
class H(http.server.SimpleHTTPRequestHandler):
    def _log(self,s):
        try:
            with open(ROOT+'/hits.log','a') as f: f.write(self.client_address[0]+' '+s+'\n')
        except Exception: pass
    def do_GET(self):
        if self.path.startswith('/log'):
            self._log(self.path); self.send_response(200); self.send_header('Content-Type','text/plain'); self.end_headers(); self.wfile.write(b'ok'); return
        return super().do_GET()
    def do_POST(self):
        try:
            n=int(self.headers.get('Content-Length','0')); b=self.rfile.read(n)
            self._log('POST '+self.path+' '+str(len(b)))
            if self.path.startswith('/put/'):
                nm=self.path[5:].replace('/','_')[:60] or 'x'; open(ROOT+'/'+nm,'wb').write(b)
            else:
                nm=self.path.strip('/').replace('/','_')[:100] or 'x'; open(ROOT+'/up/'+nm,'wb').write(b)
            self.send_response(200); self.end_headers(); self.wfile.write(b'ok')
        except Exception as e:
            self.send_response(500); self.end_headers(); self.wfile.write(str(e).encode())
    def log_message(self, fmt, *a):
        try: open(ROOT+'/access.log','a').write(self.client_address[0]+' '+(fmt%a)+'\n')
        except Exception: pass
os.chdir(ROOT)
socketserver.TCPServer.allow_reuse_address=True
socketserver.TCPServer(("0.0.0.0",PORT),H).serve_forever()
