== /root/conf/cuda.sh
#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PARENT_DIR="$(dirname "$SCRIPT_DIR")"
echo "confä¸Šä¸€çº§ç›®å½•è·¯å¾„ä¸º:$PARENT_DIR"
cuda_file=cuda_12.4.1_550.54.15_linux.run
cuda_url=https://developer.download.nvidia.com/compute/cuda/12.8.1/local_installers/cuda_12.8.1_570.124.06_linux.run

# åˆ¤æ–­CUDAå®‰è£…åŒ…æ˜¯å¦å­˜åœ¨ï¼Œä¸å­˜åœ¨åˆ™ä¸‹è½½
if [ ! -f "$PARENT_DIR/$cuda_file" ]; then
    echo "[INFO] CUDA installer not found, downloading..."
    wget -c -P "$PARENT_DIR" "$cuda_url"
    if [ $? -ne 0 ]; then
        echo "[ERROR] Download failed, please check network or URL."
        exit 1
    fi
else
    echo "[INFO] CUDA installer already exists, skipping download."
fi

chmod +x "$PARENT_DIR/$cuda_file"
mkdir -p /usr/local/cuda-12.4

cuda_path=$PARENT_DIR
CUDA_HOME=/usr/local/cuda-12.4

$cuda_path/$cuda_file --toolkit --toolkitpath=${CUDA_HOME} --librarypath=${CUDA_HOME} --samples --samplespath=${CUDA_HOME} --tmpdir=/tmp --silent
