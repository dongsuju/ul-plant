== /root/conf/mount.sh
for i in g{0003..0016}; do 
    ssh "$i" '
        echo $HOSTNAME
        # å®šä¹‰è®¾å¤‡å’ŒæŒ‚è½½ç‚¹çš„æ•°ç»„
        DEVICES=(/dev/nvme0n1 /dev/nvme1n1 /dev/nvme2n1 /dev/nvme3n1)
        MOUNT_POINTS=(/ssd1 /ssd2 /ssd3 /ssd4)
        
        # å¾ªç¯å¤„ç†æ¯ä¸ªè®¾å¤‡å’ŒæŒ‚è½½ç‚¹
        for index in ${!DEVICES[@]}; do
            DEVICE=${DEVICES[$index]}
            MOUNT_POINT=${MOUNT_POINTS[$index]}
            
            # åˆ›å»ºæŒ‚è½½ç‚¹
            mkdir -p $MOUNT_POINT
            
            # è·å–è®¾å¤‡çš„ UUID å¹¶æ·»åŠ åˆ° /etc/fstab
            UUID=$(blkid | grep "$DEVICE" | awk "{print \$2}")
            echo "${UUID} ${MOUNT_POINT} ext4 defaults 0 0" >> /etc/fstab
        done
        
        # æŒ‚è½½æ‰€æœ‰æœªæŒ‚è½½çš„æ–‡ä»¶ç³»ç»Ÿ
        mount -a
    '
done
