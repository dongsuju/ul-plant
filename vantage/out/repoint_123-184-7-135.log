#è¿™é‡Œçš„--raid-device=4è¡¨ç¤ºæœ‰4å—ç›˜ï¼Œ/dev/nvme[0-3]n1è¡¨ç¤ºç›˜æ‰€åœ¨çš„åˆ†åŒºåã€‚
sudo mkfs.ext4 /dev/md0 
sudo mkdir /ssd 

# è·å–/dev/md0çš„UUID
MD0_UUID=$(sudo blkid -s UUID -o value /dev/md0)
echo "è·å–åˆ°/dev/md0çš„UUID: $MD0_UUID"

# ä½¿ç”¨UUIDæŒ‚è½½
sudo mount UUID="$MD0_UUID" /ssd

# é…ç½®rc.localè‡ªåŠ¨æŒ‚è½½
if ! grep -q "mount.*$MD0_UUID" /etc/rc.local; then
    echo "æ·»åŠ æŒ‚è½½å‘½ä»¤åˆ°/etc/rc.local"
    
    # åœ¨æœ€åä¸€ä¸ªéç©ºè¡Œä¹‹åæ’å…¥
    sudo sed -i -e '/^[[:space:]]*$/d' -e '$a\' /etc/rc.local
    echo "mount UUID=\"$MD0_UUID\" /ssd" | sudo tee -a /etc/rc.local
else
    echo "æŒ‚è½½å‘½ä»¤å·²å­˜åœ¨äº/etc/rc.localä¸­"
fi
# é…ç½®mdadm
