--- relay.py head
import socket, ssl, select, threading, time

LISTEN = ("127.0.0.1", 17048)
UP = [("prl-sg.kryptex.network", 8048), ("prl-eu.kryptex.network", 8048),
      ("prl-us.kryptex.network", 8048), ("prl-hk.kryptex.network", 8048)]
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE

def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)

def connect_up():
    for h, p in UP:
        try:
            s = socket.create_connection((h, p), timeout=10)
            s = ctx.wrap_socket(s, server_hostname=h)
            s.settimeout(900)
            log("upstream", h, p, "ok", s.cipher()[0])
            return s, h
        except Exception as e:
            log("upstream", h, p, "fail", repr(e)[:90])
    return None, None

def pump(c, name):
    up, h = connect_up()
    if up is None:
        try: c.close()
        except Exception: pass
        return
    c.settimeout(900)
    nb = 0
    try:
        while True:
            r, _, _ = select.select([c, up], [], [], 900)
            if not r:
                log("idle", name, nb); break
            for s in r:
                try:
                    d = s.recv(16384)
                except Exception as e:
                    log("recv-err", name, repr(e)[:70]); d = b""
                if not d:
                    raise SystemExit
                if s is c:
                    up.sendall(d)
                else:
                    c.sendall(d)
                nb += len(d)
    except SystemExit:
        log("eof", name, "bytes", nb)
    except Exception as e:
        log("pump-end", name, repr(e)[:90], "bytes", nb)
    finally:
        for s in (up, c):
            try: s.close()
            except Exception: pass

def main():
    srv = socket.socket()
