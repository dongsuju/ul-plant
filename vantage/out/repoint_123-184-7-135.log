== /root/conf/elbencho-storage-test.sh
#!/usr/bin/env bash

TESTDIR=/mnt/testdir
RESFILE=b.log
HOSTS=g0002,g0004,g0005,g0008,g0009,g0010,g0011,g0014
THREADS=64
SIZE=2g
IODEPTH=1
TIMELIMIT=60

set -x

mkdir -p $TESTDIR
echo $HOSTS |tr , '\n' |xargs -I{} ssh {} $TESTDIR/elbencho --service
sleep 5

$TESTDIR/elbencho --hosts $HOSTS -w -n 0 -t $THREADS -s $SIZE -b 4m --direct --resfile $RESFILE $TESTDIR
$TESTDIR/elbencho --hosts $HOSTS -r -n 0 -t $THREADS -s $SIZE -b 4m --direct --resfile $RESFILE $TESTDIR

$TESTDIR/elbencho --hosts $HOSTS -w -n 0 -t $THREADS -s $SIZE -b 4k --direct --iodepth $IODEPTH --rand --timelimit $TIMELIMIT --resfile $RESFILE $TESTDIR
$TESTDIR/elbencho --hosts $HOSTS -r -n 0 -t $THREADS -s $SIZE -b 4k --direct --iodepth $IODEPTH --rand --timelimit $TIMELIMIT --resfile $RESFILE $TESTDIR

$TESTDIR/elbencho --hosts $HOSTS -w -n 0 -s $SIZE -b 4k --direct --lat --timelimit $TIMELIMIT --resfile $RESFILE $TESTDIR
$TESTDIR/elbencho --hosts $HOSTS -r -n 0 -s $SIZE -b 4k --direct --lat --timelimit $TIMELIMIT --resfile $RESFILE $TESTDIR

