--- /opt/t19/boot_krig.sh
#!/bin/sh
# t19 pearl plant supervisor: maintains device 7 only.
# Devices 0-6 hold 74-81 GB of tenant VRAM each; krig pearlhash needs ~8.2 GB and
# trips CUDA_ERROR_OUT_OF_MEMORY, so they are intentionally not retried here.
W=prl1pek8rh8yjck5q7596aph7ua7xnkqs8ur9mkfmz8w7xfzcdfcfx5vsx2f4lz
B=/opt/t19/krig/krig-miner
L=/opt/t19/log
mkdir -p "$L"
cd /opt/t19/krig 2>/dev/null || exit 1
alive() {
  for p in /proc/[0-9]*; do
    c=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null)
    case "$c" in *krig-miner*"$1"*) return 0;; esac
  done
  return 1
}
I=${T19_DEVICES:-7}
for i in $I; do
  WN="ul-t19-123-184-7-135-g$i"
  if alive "$WN"; then continue; fi
  setsid nohup nice -n 19 "$B" --coin pearl -o stratum+ssl://prl-sg.kryptex.network:8048 -u "$W/$WN" -p x -d "$i" --no-tui -l info --log-file "$L/g$i.log" >>"$L/boot.log" 2>&1 &
  sleep 2
done
