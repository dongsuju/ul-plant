== /root/conf/unlimit.sh
for i in {2..16}
do
  HOST="g$(printf "%04d" $i).para.ai"
  echo "Updating .bashrc on $HOST"
  
  # ä½¿ç”¨ ssh è¿œç¨‹ç™»å½•åˆ°æ¯å°æœåŠ¡å™¨å¹¶è¿½åŠ  ulimit åˆ° .bashrc
  ssh root@$HOST 'echo "ulimit -l unlimited" >> /root/.bashrc;source /root/.bashrc'
done
== /root/conf/yaml.sh
#!/bin/bash

# ç­‰å¾…ç½‘ç»œæœåŠ¡å°±ç»ª
