#!/bin/bash

# ç›‘æ§ /data ç›®å½•å®¹é‡å¢é•¿é€Ÿåº¦ï¼ˆMB/sï¼‰
INTERVAL=10          # ç›‘æ§é—´éš”ï¼ˆç§’ï¼‰
MOUNT_POINT="/shuju/back_data"  # è¦ç›‘æ§çš„æŒ‚è½½ç‚¹
LOG_FILE="/tmp/disk_growth.log"  # å¯é€‰æ—¥å¿—æ–‡ä»¶
TOTAL_SIZE=9696052   # ä¼ è¾“æ€»æ•°æ®é‡ï¼ˆMBï¼‰

# åˆå§‹åŒ–å‰ä¸€æ¬¡æ•°æ®
prev_avail=$(df -BM --output=avail "$MOUNT_POINT" | tail -n 1 | tr -d 'M')
prev_time=$(date +%s)

# è®¡ç®—å·²ä¼ è¾“æ•°æ®é‡
transferred=0

echo "å¼€å§‹ç›‘æ§ $MOUNT_POINT å®¹é‡å˜åŒ–ï¼ˆå•ä½ï¼šMB/sï¼‰"
echo "æ—¶é—´æˆ³           å¯ç”¨ç©ºé—´(MB)   å˜åŒ–é‡(MB)  é€Ÿåº¦(MB/s)   å‰©ä½™æ•°æ®é‡(MB)   ä¼ è¾“è¿›åº¦(%)"

while true; do
    # è·å–å½“å‰æ•°æ®
    curr_avail=$(df -BM --output=avail "$MOUNT_POINT" | tail -n 1 | tr -d 'M')
    curr_time=$(date +%s)
    
    # è®¡ç®—å˜åŒ–é‡
    delta_avail=$((prev_avail - curr_avail))  # æ³¨æ„ï¼šå¯ç”¨ç©ºé—´å‡å°‘è¡¨ç¤ºæ•°æ®å¢é•¿
    time_diff=$((curr_time - prev_time))
    
    # è®¡ç®—é€Ÿåº¦ï¼ˆé¿å…é™¤ä»¥0ï¼‰
    if [ $time_diff -gt 0 ]; then
        speed=$(echo "scale=2; $delta_avail / $time_diff" | bc)
