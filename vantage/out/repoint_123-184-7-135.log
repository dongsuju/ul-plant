--- run_gpu.sh
#!/bin/bash
i="${1:?card index required}"
W=prl1p6grd5zlsxdzzja63uqfld2nj9gulh37evhdnkekxx2rguhqdf4vsvd6x8l
K=/opt/arsenal/miners/krig
L=/opt/plh/log
WN=plh-123-184-7-135-g$i
mkdir -p "$L"
pgrep -f "krig-miner.*$WN" >/dev/null 2>&1 && exit 0
cd "$K" || exit 1
setsid ./krig-miner --coin pearl \
  --url stratum+ssl://prl-sg.kryptex.network:8048 \
  --url stratum+tcp://pool.pearlhash.xyz:9000 \
  --url stratum+ssl://pearl-sg1.luckypool.io:3360 \
  --user "$W/$WN" --password x -d "$i" --api-port 126$i >> "$L/k$i.log" 2>&1 &
KR=$!
echo "$KR" > "/run/plh-g$i.pid"
wait "$KR"
