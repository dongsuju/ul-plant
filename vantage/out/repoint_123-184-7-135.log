#!/bin/bash
  
# 获取当前脚本的绝对路径
conf_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 获取原始调用用户
original_user="${SUDO_USER:-$USER}"

# 检查原始调用用户是否为 root
if [ "$original_user" = "root" ]; then
    # 原始调用用户是 root
    echo "user name: root"
    cp "${conf_dir}/root_rsa/sshd_config" /etc/ssh/
    cp "${conf_dir}/root_rsa/ssh_config" /etc/ssh/
else
    # 原始调用用户不是 root
    echo "user name: $original_user"
    cp "${conf_dir}/ubuntu_rsa/sshd_config" /etc/ssh/
    cp "${conf_dir}/ubuntu_rsa/ssh_config" /etc/ssh/
fi

# 重启 sshd 服务
systemctl restart sshd
