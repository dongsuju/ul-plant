===== /root/conf/ubuntu闆嗙兢閮ㄧ讲.docx (649208B)
1、配置/etc/hosts
2、配置ssh互信
ssh-keygen -t rsa
cp ~/.ssh/id_rsa.pub ~/.ssh/authorized_keys
scp ~/.ssh g0001:~
3、配置ubuntu用户sudo 不要密码
ubuntu    ALL=(ALL:ALL)  NOPASSWD: ALL
创建一个主机名列表文件hostlist
4、设置主机名
for i in `cat hostlist` ; do ssh $i &quot;sudo hostnamectl set-hostname $i&quot; ;done
5、挂盘
pvcreate /dev/nvme0n1
pvcreate /dev/nvme1n1
pvcreate /dev/nvme2n1
pvcreate /dev/nvme3n1
创建物理卷
vgcreate vg1 /dev/nvme0n1 /dev/nvme1n1 /dev/nvme2n1 /dev/nvme3n1
创建一个vg1卷组名，并把/dev/nvme0n1 /dev/nvme1n1 /dev/nvme2n1 /dev/nvme3n1物理卷加入其中。
lvcreate -l 100%VG -n lv1 vg1
这个含义是创建新的lv1,把所有的vg1划给1个lv1，并取名lv1。
参考链接:https://blog.csdn.net/wangsong_it/article/details/107509170
mkfs.ext4 /dev/mapper/vg1-lv1
格式化，并创建ext4文件系统
条带化：
lvcreate -l 100%VG -i 2 -I 8 -n lv1 vg1
mkdir /ssd
vim /etc/fstab
/dev/mapper/vg1-lv1 /ssd ext4  defaults,errors=remount-ro  0 0
mount -a
ssd盘挂到ssd目录
6、配置NFS server
在g0001执行
sudo apt-get -y install nfs-kernel-server
mkdir /ssd/apps
sudo vim /etc/exports
/ssd/apps 10.31.17.0/25(rw,no_root_squash,insecure,sync)
sudo /etc/init.d/rpcbind restart
sudo /etc/init.d/nfs-kernel-server restart
sudo systemctl start  nfs-server
sudo systemctl enable nfs-server
sudo systemctl status nfs-server
如果在客户端出现这种stale file handle情况，可以在服务端重新启动nfs服务：
sudo /etc/init.d/rpcbind restart
sudo /etc/init.d/nfs-kernel-server restart
造成这种原因是，服务端机器重启过，但是重启前没有umount共享盘
验证：
sudo showmount -e
注意：如果是新增节点要挂载，需要先将新增节点补充到/etc/exports里面，再执行exportfs -ra (重新加载配置)刷新下配置)。
然后到在服务端批量执行for i in `cat hostlist-new`;do ssh $i &quot;mount 172.16.10.11:/ssd/run /root/run&quot;;done
这里的172.16.10.11是服务端IP
客户端挂载：
#!/bin/bash
apt -y install nfs-common
mkdir -p /data/apps
mount -t nfs -o vers=3,nolock,proto=tcp,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2,noresvport 10.31.17.2:/ssd/apps /data/apps
#echo &quot;mount -t nfs -o vers=3,nolock,proto=tcp,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2,noresvport 10.31.17.2:/ssd/apps /data/apps&quot; >> /etc/rc.local
Noresvport 存在的目的是为了可以避免网络闪断导致 nfs hang 住，请注意，如果后面有了Noresvport前面也需要有insecure存在，否则会出现权限问题。
sudo-t nfs -o
挂载将NFS协议的网络文件系统以硬盘形式挂载
vers=
NFS客户端版本
proto=tcp
以TCP网络形式连接，相较于UDP更可靠
rsize=1048576
在NFS服务器读取文件时NFS使用的字节数，默认值是1024个字节，最大1048576字节， 该值越大，向服务器发送的请求包越少，性能越高。
wsize=1048576
向NFS服务器写文件时NFS使用的字节数 默认值是1024个字节，最大1048576字节，该值越大，向服务器发送的请求包越少，性能越高。
hard
使用硬挂载的方式挂载系统 ，重复请求直到NFS服务器回应。；适用于不希望业务由于网络延迟或服务器服务重启或短暂的过载等情况而中断场景
timeo=600
对于基于TCP的NFS服务，默认等待重传时间为60s ，数据越大，持续重传的时间越长，可减少数据传输失败概率。
retrans=2
客户端返回错误前的重传次数。默认为重传3次。
noresvport
该参数将在后端NFS失效情况下进行持续性重连，适用于联通云服务高可用场景
mount_path
文件系统提供的挂载点，为在文件存储控制台-文件系统列表/相应文件系统详情页面中获取挂载点信息，某些场景下使用根目录进行挂载可能存在问题，可以于“mount_path”后添加“/share”路径进行挂载。
/mnt
将文件系统挂载的目录
智谱批量执行示例：
pdsh -R ssh -w g[0001-0046] &quot;sudo sh -c 'echo sudo mount -t nfs -o vers=3,nolock,proto=tcp,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2,noresvport 10.254.27.100:/volume1/data /nas1 >> /etc/fstab'&quot;
pdsh -R ssh -w g[0001-0046] &quot;sudo sh -c 'echo sudo mount -t nfs -o vers=3,nolock,proto=tcp,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2,noresvport 10.254.27.101:/volume1/data /nas2 >> /etc/fstab'&quot;
如果出现这个报错：Mount failed with mount: mount.nfs: access denied by server while mounting error
可能有以下原因：
1、/etc/exports 里面insecure 和 rc.local里面mount -t nfs -o vers=3,nolock,proto=tcp,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2,noresvport 10.31.17.2:/ssd/apps /data/apps 没有成对出现，如果是因为这个原因，可以把2者都取消，或者都写上，增减参数后，记得执行exportfs -ra，再systemctl restart rc-local.service 以及systemctl status rc-local.service，如果不奏效，直接mount -t nfs -o vers=3,nolock,proto=tcp,rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2 10.31.17.2:/ssd/apps /data/apps
2、还有一个原因就是，看10.31.17.2:/ssd/apps /data/apps 里面，目录顺序是否弄反了。
批量执行：
for i in cat hostlist ; do scp mountnfs.sh $i:~/ ;done
for i in cat hostlist ; do (  ssh $i  &quot;sudo ~/mountnfs.sh&quot; &);done
7、同步/etc/hosts
for i in `cat hostlist` ; do ( ssh $i &quot;sudo /data/apps/conf/synchosts.sh&quot; & );done
8、配置rc.local
将rc.local 放到共享目录下面路径 /data/apps/conf/rc.local
#!/bin/bash
echo &quot;&quot; >> /lib/systemd/system/rc-local.service
echo &quot;[Install]&quot; >> /lib/systemd/system/rc-local.service
echo &quot;WantedBy=multi-user.target&quot; >> /lib/systemd/system/rc-local.service
#echo -e '#!/bin/bash\n' | cat - /etc/rc.local > temp && mv temp /etc/rc.local
cp /data/apps/conf/rc.local /etc/rc.local
chmod 755 /etc/rc.local
systemctl daemon-reload
systemctl restart rc-local.service  #如果是用到IB网络，需要注意
systemctl enable rc-local.service
systemctl status rc-local.service
批量执行
for i in `cat hostlist` ; do ssh $i &quot;sudo /data/apps/conf/rclocal.sh&quot; ;done
更新rc.local 
for i in cat hostlist ; do ( ssh $i &quot;sudo /data/apps/conf/syncrclocal.sh&quot; & ) ;done
