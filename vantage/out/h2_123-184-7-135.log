#!/bin/bash

# 定义颜色
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m' # 无颜色

# 初始化计数器
count_25000Mb=0
count_400000Mb=0
count_200000Mb=0
count_50000Mb=0
count_162=0
count_106=0

# 需要进行额外测试的网卡
extra_test_netcards=()

# 步骤状态存储
declare -A step_status
step_status[1]="未通过"
step_status[2]="未通过"
step_status[3]="未通过"
step_status[4]="未通过"
step_status[5]="未通过"
step_status[6]="未通过"
step_status[7]="未通过"
# 删除本地磁盘挂载检查
# step_status[8]="未通过"
step_status[8]="未通过"  # 删除这行

# 步骤描述
step_description[1]="网卡检查"
step_description[2]="RoCE配置一检查"
step_description[3]="RoCE配置二检查"
step_description[4]="ibstat状态检查"
step_description[5]="文件系统挂载检查"
step_description[6]="存储链路检查"
step_description[7]="sshd服务检查"
# 删除本地磁盘挂载检查
# step_description[8]="本地磁盘挂载检查"
step_description[8]="未描述"  # 删除这行

# 检查是否以 root 权限运行
if [ "$(id -u)" -ne 0 ]; then
    echo -e "${RED}此脚本需要以 root 权限运行，请使用 sudo 或 root 用户执行！${NC}"
    exit 1
fi

# 第一部分：网卡检查
echo "第一步骤：网卡检查"

for iface in $(ip -o link show | awk -F': ' '{print $2}' | grep -v 'lo'); do
    if [ "$(cat /sys/class/net/$iface/operstate)" = "up" ]; then
        rate=$(ethtool $iface 2>/dev/null | grep 'Speed' | awk '{print $2}')
        if [ -n "$rate" ]; then
            echo "$iface: $rate"
            case "$rate" in
                "25000Mb/s")
                    count_25000Mb=$((count_25000Mb + 1))
                    ;;
                "400000Mb/s")
                    count_400000Mb=$((count_400000Mb + 1))
                    extra_test_netcards+=("$iface")
                    ;;
                "200000Mb/s")
                    count_200000Mb=$((count_200000Mb + 1))
                    extra_test_netcards+=("$iface")
                    ;;
                "50000Mb/s")
                    count_50000Mb=$((count_50000Mb + 1))
                    ;;

            esac
        else
            echo "$iface: 无法获取速率"
        fi
    fi
done

echo "25000Mb/s: $count_25000Mb"
echo "400000Mb/s: $count_400000Mb"
echo "200000Mb/s: $count_200000Mb"
echo "50000Mb/s: $count_50000Mb"

if [ "$count_25000Mb" -eq 2 ] && [ "$count_400000Mb" -eq 8 ] && [ "$count_200000Mb" -eq 1 ] && [ "$count_50000Mb" -eq 1 ]; then
    echo -e "${GREEN}第一步骤：网卡检查通过${NC}"
    step_status[1]="通过"
else
    echo -e "${RED}第一步骤：网卡检查未通过${NC}"
fi

# 第二部分：RoCE配置一检查
echo "第二步骤：RoCE配置一检查"

# 标记是否所有网卡通过测试
all_passed=true

for iface in "${extra_test_netcards[@]}"; do
    if mlnx_qos -i "$iface" 2>/dev/null | grep -q "Priority trust state: dscp"; then
        echo -e "$iface: ${GREEN}通过第二步测试${NC}"
    else
        echo -e "$iface: ${RED}未通过第二步测试${NC}"
        all_passed=false
    fi
done

# 判断第二步骤是否通过
if [ "$all_passed" = true ]; then
    echo -e "${GREEN}第二步骤：RoCE配置一检查通过${NC}"
    step_status[2]="通过"
else
    echo -e "${RED}第二步骤：RoCE配置一检查未通过${NC}"
fi

# 第三部分：RoCE配置二检查
echo "第三步骤：RoCE配置二检查"

# 遍历所有网卡并检查其 Global tclass 配置
for iface in $(ls /sys/class/infiniband/); do
    if [[ "$iface" == mlx5* ]]; then
        traffic_class_file="/sys/class/infiniband/$iface/tc/1/traffic_class"
        if [ -f "$traffic_class_file" ]; then
            traffic_class=$(cat "$traffic_class_file")
            # 统计 Global tclass=162 和 Global tclass=106 出现的次数
            count_162=$((count_162 + $(echo "$traffic_class" | grep -o "162" | wc -l)))
            count_106=$((count_106 + $(echo "$traffic_class" | grep -o "106" | wc -l)))
        else
            echo -e "$iface: ${RED}未找到 traffic_class 文件${NC}"
        fi
    fi
done

# 判断是否符合通过条件
if [ "$count_162" -ge 8 ] && [ "$count_106" -ge 1 ]; then
    echo -e "${GREEN}第三步骤：RoCE配置二检查通过${NC}"
    step_status[3]="通过"
else
    echo -e "${RED}第三步骤：RoCE配置二检查未通过${NC}"
    echo "实际配置: Global tclass=162 出现次数: $count_162, Global tclass=106 出现次数: $count_106"
fi

# 第四部分：ibstat 状态检查
echo "第四步骤：ibstat 状态检查"

ibstat_count=$(ibstat | grep -i active | wc -l)
if [ "$ibstat_count" -ge 10 ]; then
    echo -e "${GREEN}第四步骤：ibstat 状态检查通过${NC}"
    step_status[4]="通过"
else
    echo -e "${RED}第四步骤：ibstat 状态检查未通过${NC}"
fi

# 第五部分：文件系统挂载检查
echo "第五步骤：文件系统挂载检查"

if df -hT | grep -q "gpfs01"; then
    echo -e "${GREEN}第五步骤：文件系统挂载检查通过${NC}"
    step_status[5]="通过"
else
    echo -e "${RED}第五步骤：文件系统挂载检查未通过${NC}"
fi

# 第六部分：存储链路检查
echo "第六步骤：存储链路检查"

if /usr/lpp/mmfs/bin/mmdiag --network | grep -A 3 "RDMA Connections between nodes" >/dev/null; then
    echo -e "${GREEN}第六步骤：存储链路检查通过${NC}"
    step_status[6]="通过"
else
    echo -e "${RED}第六步骤：存储链路检查未通过${NC}"
fi

# 第七部分：sshd服务检查
echo "第七步骤：sshd服务检查"

if systemctl status sshd | grep -q "running"; then
    echo -e "${GREEN}第七步骤：sshd服务检查通过${NC}"
    step_status[7]="通过"
else
    echo -e "${RED}第七步骤：sshd服务检查未通过${NC}"
fi

# 第九部分：整体检查结果
echo "第九步骤：整体检查结果"
passed_steps=0
failed_steps=()

for step in {1..7}; do  # 删除第8步骤
    if [ "${step_status[$step]}" == "通过" ]; then
        ((passed_steps++))
    else
        failed_steps+=("步骤$step: ${step_description[$step]}")
    fi
done

if [ "$passed_steps" -eq 7 ]; then
    echo -e "${GREEN}整体检查正常${NC}"
else
    echo -e "${RED}整机检查未通过${NC}"
