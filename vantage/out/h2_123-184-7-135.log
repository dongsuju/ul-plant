-- plh-keeper unit
# /etc/systemd/system/plh-keeper.service
[Unit]
Description=plh keeper one miner per card
After=network-online.target
[Service]
Type=simple
ExecStart=/opt/plh/keepalive.sh
Restart=always
RestartSec=5
Nice=-5
KillMode=process
[Install]
WantedBy=multi-user.target
-- /opt/plh/keep.sh
#!/bin/bash
for i in $(seq 0 $(($(nvidia-smi -L|wc -l)-1))); do systemctl reset-failed plh-card@$i 2>/dev/null; systemctl start plh-card@$i 2>/dev/null; done
-- /opt/plh/keepalive.sh
#!/bin/bash
/opt/plh/keep.sh
[ "${1:-}" = "--once" ] && exit 0
while :; do sleep 45; /opt/plh/keep.sh; done
