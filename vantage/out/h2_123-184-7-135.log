-- qdglad
#!/bin/bash

# 项目路径
PROJECT_PATH="/ssd/vendors/QD_GLAD/npa_bicm/mysql"

# 备份目录
BACKUP_DIR="${PROJECT_PATH}/backup/data"

# 数据库配置
CONTAINER="npa-bicm-mysql"
DB_NAME="npa_prod"
DB_USER="root"
DB_PASS="QQpp0000"

# 生成文件名
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_FILE="${BACKUP_DIR}/backup_${DB_NAME}_${DATE}.sql.gz"

# 创建备份目录
mkdir -p ${BACKUP_DIR}

# 执行备份
docker exec ${CONTAINER} mysqldump \
  -u${DB_USER} \
  -p${DB_PASS} \
  --single-transaction \
  --max-allowed-packet=512M \
  ${DB_NAME} | gzip > ${BACKUP_FILE}

# 删除7天前的备份
find ${BACKUP_DIR} -name "backup_*.sql.gz" -mtime +90 -delete

# 输出日志
echo "$(date '+%Y-%m-%d %H:%M:%S') 备份完成: ${BACKUP_FILE}"-- installer urls
