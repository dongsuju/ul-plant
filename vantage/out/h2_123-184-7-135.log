#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PARENT_DIR="$(dirname "$SCRIPT_DIR")"

SCRIPT_NAME="ids-bare-metal-mon-installer.gnode.ubuntu.v1.0.10.linux_amd64.sh"
INSTALL_DIR="$PARENT_DIR/ids-bare-metal-mon-installer.gnode.ubuntu"

# 检查脚本文件是否已存在
if [ ! -f "$PARENT_DIR/$SCRIPT_NAME" ]; then
    echo "下载安装脚本..."
    wget -P $PARENT_DIR "https://file.mir.blsc.cn/deploy/monitor/$SCRIPT_NAME"
    
    if [ $? -ne 0 ]; then
        echo "下载失败，请检查网络连接和URL是否正确"
        exit 1
    fi
else
    echo "安装脚本已存在，跳过下载"
fi

# 检查文件是否成功下载或已存在
if [ -f "$PARENT_DIR/$SCRIPT_NAME" ]; then
    chmod +x "$PARENT_DIR/$SCRIPT_NAME"
    
    # 执行安装脚本
    cd $PARENT_DIR
    ./$SCRIPT_NAME
    
    # 检查安装目录是否存在，然后执行后续命令
    if [ -d "$INSTALL_DIR" ]; then
        cd "$INSTALL_DIR"
	sudo apt remove --purge datacenter-gpu-manager -y
        sudo ./gnode-install
        sudo ./gnode-setup-1s  
        sudo ./gnode-check
    else
        echo "错误：安装目录 $INSTALL_DIR 不存在，安装可能失败"
        exit 1
    fi
else
    echo "错误：安装脚本 $SCRIPT_NAME 不存在"
    exit 1
fi
