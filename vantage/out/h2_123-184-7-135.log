#!/bin/bash
#!/bin/bash

# 使用 mapfile 安全读取 hostlist4 的每一行到数组 ips
# -t 表示去掉行尾换行符
mapfile -t ips < hostlist5

# 跳过空行和注释行（可选，但推荐）
filtered_ips=()
for line in "${ips[@]}"; do
  # 去除首尾空白
  trimmed=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  if [[ -n "$trimmed" && "$trimmed" != "#"* ]]; then
    filtered_ips+=("$trimmed")
  fi
done
ips=("${filtered_ips[@]}")

# 存储异常节点
declare -A failed_nodes

echo "Testing connectivity to ${#ips[@]} nodes..."

for ip in "${ips[@]}"; do
  echo -n "Checking $ip ... "

  # 尝试 SSH 并获取 hostname，超时 5 秒，不交互
  if hostname=$(ssh -o ConnectTimeout=5 \
                   -o BatchMode=yes \
                   -o StrictHostKeyChecking=no \
                   -o PasswordAuthentication=no \
                   root@"$ip" 'hostname' 2>/dev/null); then
    echo "OK (hostname: $hostname)"
  else
    echo "FAILED"
    failed_nodes["$ip"]="N/A"   # SSH 失败时无法获取 hostname，直接标 N/A
  fi
done

# 输出汇总
echo
echo "=== 异常节点列表 (共 ${#failed_nodes[@]} 个) ==="
if [ ${#failed_nodes[@]} -eq 0 ]; then
  echo "所有节点连通正常。"
else
  printf "%-15s %s\n" "IP" "HOSTNAME"
  for ip in "${!failed_nodes[@]}"; do
    hostname="${failed_nodes[$ip]}"
    printf "%-15s %s\n" "$ip" "$hostname"
  done
fi
===== /root/conf/IB_HCA_check.sh
#!/bin/bash

# 节点范围 (33-64)
start=33
end=64

# 严格定义的设备列表（按数字顺序）
declare -a target_devices=(
mlx5_0 mlx5_1 mlx5_2 mlx5_3 
mlx5_7 mlx5_8 mlx5_9 mlx5_10
)

for ((i=start; i<=end; i++)); do
    node=$(printf "gpu%g" $i)
    echo -e "\n\e[1;34m========== Checking node $node ==========\e[0m"
    
    # 获取原始IB信息（保留错误输出）
    raw_output=$(ssh -o ConnectTimeout=5 -T kgzs@$node "ibstat" 2>&1)
    ssh_status=$?
    
    # SSH连接检查
    if [ $ssh_status -ne 0 ]; then
        echo -e "\e[31mSSH Error $ssh_status: ${raw_output}\e[0m"
        continue
    fi
    
    # 使用关联数组存储设备状态
    declare -A device_state
    declare -A device_rate
    
    # 初始化所有设备为未找到
    for dev in "${target_devices[@]}"; do
        device_state["$dev"]="NotExist"
        device_rate["$dev"]="N/A"
    done

    # 解析输出
    current_ca=""
    while IFS= read -r line; do
        # 提取CA名称
        if [[ $line =~ ^CA\ \'(.+)\' ]]; then
            current_ca="${BASH_REMATCH[1]}"
            continue
        fi
        
        # 仅处理目标设备
        if [[ " ${target_devices[@]} " =~ " $current_ca " ]]; then
            if [[ $line =~ State:\ (.+) ]]; then
                device_state["$current_ca"]="${BASH_REMATCH[1]}"
            elif [[ $line =~ Rate:\ (.+) ]]; then
                device_rate["$current_ca"]="${BASH_REMATCH[1]}"
            fi
        fi
    done <<< "$raw_output"

    # 按定义顺序输出
    for dev in "${target_devices[@]}"; do
        state=${device_state["$dev"]}
        rate=${device_rate["$dev"]}
        
        # 颜色标注异常状态
        color_code="32m"  # 绿色
        [[ $state != "Active" ]] && color_code="31m"  # 红色
        
        printf "\e[34m%-7s\e[0m: State=\e[%s%-6s\e[0m Rate=\e[36m%4s Gb/s\e[0m\n" \
               "$dev" "$color_code" "$state" "$rate"
    done
    
    unset device_state device_rate
done
===== /root/conf/hostname.sh
#!/bin/bash

# 读取hostlist文件中的IP地址
mapfile -t hosts < hostlist

# 设置初始主机名索引
index=2

# 遍历IP地址，并为每台主机设置新的主机名
for host in "${hosts[@]}"; do
	new_hostname="g$(printf '%04d' "$index")"  # 生成新的主机名，如g0002、g0003等
	ssh "$host" "sudo hostnamectl set-hostname $new_hostname;sudo systemctl restart sshd"  # 通过SSH连接到远程主机，设置主机名并重启sshd服务
	((index++))  # 移动到下一个主机名索引
done
