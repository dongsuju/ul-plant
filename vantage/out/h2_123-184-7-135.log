#!/bin/bash
export PATH=/ssd/apps/openmpi-4.1.2/install/bin:/ssd/apps/nccl-tests-master/build:$PATH
export LD_LIBRARY_PATH=/ssd/apps/openmpi-4.1.2/install/lib:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/ssd/apps/nccl/build/lib:$LD_LIBRARY_PATH
export NCCL_IB_HCA=mlx5_0:1,mlx5_1:1,mlx5_4:1,mlx5_5:1
export NCCL_IB_DISABLE=0
export NCCL_SOCKET_IFNAME=bond0
cat /dev/null > hostfile
for host in $(scontrol show hostnames); do
        MPI_HOSTS=&quot;${host} slots=8&quot;
        echo -e &quot;$MPI_HOSTS&quot; >> hostfile
done
mpirun -x LD_LIBRARY_PATH -x PATH -x NCCL_IB_HCA=mlx5_0:1,mlx5_1:1,mlx5_4:1,mlx5_5:1 -x NCCL_IB_DISABLE=0 -x NCCL_ALGO=Ring --mca btl ^tcp --hostfile hostfile all_reduce_perf b 8 -e 8G -f 2 -g 1
#!/bin/bash
export PATH=/ssd/apps/openmpi-4.1.2/install/bin:/ssd/apps/nccl-tests-master/build:$PATH
export LD_LIBRARY_PATH=/ssd/apps/openmpi-4.1.2/install/lib:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/ssd/apps/nccl/build/lib:$LD_LIBRARY_PATH
export NCCL_IB_HCA=mlx5_0:1,mlx5_1:1,mlx5_4:1,mlx5_5:1
export NCCL_IB_DISABLE=0
export NCCL_SOCKET_IFNAME=bond0
cat /dev/null > hostfile
for host in $(scontrol show hostnames); do
        MPI_HOSTS=&quot;${host} slots=8&quot;
