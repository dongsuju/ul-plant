#!/usr/bin/env bash

# 遇到错误时立即退出脚本
set -e

# 脚本所在目录作为安装根目录
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"

# 设置变量
CUDA_VERSION="12.8.0"
CUDA_INSTALLER="cuda_${CUDA_VERSION}_570.86.10_linux.run"
CUDA_PATH="$BASE_DIR/cuda/${CUDA_VERSION}"
CUDA_FILE_PATH="$BASE_DIR/${CUDA_INSTALLER}"
OPENMPI_VERSION="4.1.1" 
OPENMPI_TAR="openmpi-${OPENMPI_VERSION}.tar.gz"
OPENMPI_PATH="$BASE_DIR/openmpi"
NCCL_REPO="https://gitee.com/mrzhoujingyu/nccl.git"
NCCL_TESTS_REPO="https://gitee.com/mrzhoujingyu/nccl-tests.git"
GPU_BURN_REPO="https://gitee.com/mrzhoujingyu/gpu-burn.git"
NUM_CORES=$(nproc)

# 获取 GPU 名称并映射到架构
GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader)
case "$GPU_NAME" in
    *"V100"*)   GPU_ARCH="70" ;;  # Volta
    *"H20"*)   GPU_ARCH="90" ;;  # Hopper
    *"A100"*)  GPU_ARCH="80" ;;  # Ampere
    *"A800"*)  GPU_ARCH="80" ;;  # Ampere
    *"RTX 3090"*) GPU_ARCH="86" ;;  # Ampere
    *"H100"*)  GPU_ARCH="90" ;;  # Hopper
    *"H200"*)  GPU_ARCH="90" ;;  # Hopper
    *"H800"*)  GPU_ARCH="90" ;;  # Hopper
    *"RTX 4090"*) GPU_ARCH="89" ;;  # Ada
    *"RTX 5090"*) GPU_ARCH="120" ;;  # 
    *"B200"*) GPU_ARCH="100" ;;  # B
    *"B300"*) GPU_ARCH="103" ;;  # B
    *)
        echo "未识别的 GPU 型号: $GPU_NAME"
        exit 1
        ;;
esac

echo "识别的 GPU 架构：$GPU_ARCH"
echo "当前 CUDA 版本：$CUDA_VERSION"

# 步骤 1：编译 CUDA
echo "开始编译 CUDA..."
if [ -d "/usr/local/cuda" ]; then
    echo "检测到 /usr/local/cuda 已存在，跳过 CUDA 编译步骤"
    CUDA_HOME="/usr/local/cuda"
else
    if [ ! -f "$CUDA_FILE_PATH" ]; then
        wget -P "$BASE_DIR" \
             https://developer.download.nvidia.com/compute/cuda/${CUDA_VERSION}/local_installers/${CUDA_INSTALLER}
    fi
    chmod +x "$CUDA_FILE_PATH"
    mkdir -p "$CUDA_PATH"
    CUDA_HOME="$CUDA_PATH"
    # 安装 CUDA Toolkit
    "$CUDA_FILE_PATH" --toolkit --toolkitpath=$CUDA_HOME --librarypath=$CUDA_HOME \
         --samples --samplespath=$CUDA_HOME --tmpdir=/tmp --silent
fi

# 步骤 2：编译 OpenMPI
echo "开始编译 OpenMPI..."
if [ ! -f "$BASE_DIR/$OPENMPI_TAR" ]; then
    wget -P "$BASE_DIR" https://file.mir.blsc.cn/deploy/paratest/jichu/$OPENMPI_TAR
fi
mkdir -p "$BASE_DIR/openmpi"
tar xf "$BASE_DIR/$OPENMPI_TAR" -C "$BASE_DIR"
sudo apt-get update && sudo apt-get install -y libnuma-dev
cd "$BASE_DIR/openmpi-${OPENMPI_VERSION}"
./configure --enable-orterun-prefix-by-default \
            --enable-mpirun-prefix-by-default \
            --enable-mpi-cxx --without-verbs \
            --with-ucx=/usr \
            --with-cuda=$CUDA_HOME --disable-getpwuid --with-slurm \
            --prefix=$OPENMPI_PATH
make -j${NUM_CORES}
make install -j${NUM_CORES}

# 步骤 3：编译 NCCL
echo "开始编译 NCCL..."
if [ ! -d "$BASE_DIR/nccl" ]; then
    git clone $NCCL_REPO "$BASE_DIR/nccl"
fi
cd "$BASE_DIR/nccl"
make -j${NUM_CORES} src.build NVCC_GENCODE="-gencode=arch=compute_${GPU_ARCH},code=sm_${GPU_ARCH}" CUDA_HOME=$CUDA_HOME
NCCL_HOME="$PWD/build"

# 步骤 4：编译 NCCL-Tests
echo "开始编译 NCCL-Tests..."
if [ ! -d "$BASE_DIR/nccl-tests" ]; then
    git clone $NCCL_TESTS_REPO "$BASE_DIR/nccl-tests"
fi
cd "$BASE_DIR/nccl-tests"
make -j${NUM_CORES} MPI=1 MPI_HOME=$OPENMPI_PATH CUDA_HOME=$CUDA_HOME NCCL_HOME=$NCCL_HOME
NCCL_TESTS_HOME="$PWD/build"

# 步骤 5：编译 GPU-Burn
echo "开始编译 GPU-Burn..."
if [ ! -d "$BASE_DIR/gpu-burn" ]; then
    git clone $GPU_BURN_REPO "$BASE_DIR/gpu-burn"
fi
cd "$BASE_DIR/gpu-burn"
# 修改 Makefile 中的参数
sed -i "s|COMPUTE[[:space:]]*?=[[:space:]]*[0-9]*|COMPUTE ?= ${GPU_ARCH}|" Makefile
sed -i "s|CUDA_VERSION ?=.*|CUDA_VERSION ?= ${CUDA_VERSION}|" Makefile
sed -i "s|CUDAPATH ?=.*|CUDAPATH ?= ${CUDA_HOME}|" Makefile
sed -i "s|/usr/bin/nvcc|${CUDA_HOME}/bin/nvcc|g" Makefile
sed -i "s|/usr/local/cuda/bin/nvcc|${CUDA_HOME}/bin/nvcc|g" Makefile
sed -i "s|/usr/local/cuda|${CUDA_HOME}|g" Makefile
make
gpu_burn_home="$PWD"

echo "所有软件已编译完成。"
echo "CUDA 版本：$CUDA_VERSION"
echo "OpenMPI 版本：$OPENMPI_VERSION"
echo "NCCL 编译路径：$NCCL_HOME"
echo "NCCL-Tests 编译路径：$NCCL_TESTS_HOME"
