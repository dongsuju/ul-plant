#!/bin/bash
# ==========================================
# 预下载脚本 - 在部署环境前下载所需软件
# 用法: ./prefetch.sh [驱动版本] [Ubuntu版本代号]
# 示例: ./prefetch.sh 580.105.08 ubuntu2204
# ==========================================

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PARENT_DIR="$(dirname "$SCRIPT_DIR")"
DOWNLOAD_DIR="$PARENT_DIR"

# ================= 配置区域 =================
# 支持命令行传参，未传参则使用默认值
DRIVER_VERSION="${1:-580.105.08}"
UBUNTU_CODENAME="${2:-ubuntu2204}"
CUDA_VERSION="12.8.1"
CUDA_DRIVER_PART="570.124.06"

# 提取主版本号（如 580.105.08 -> 580）
MAJOR_VERSION=$(echo "$DRIVER_VERSION" | cut -d. -f1)

# ================= 下载文件列表 =================
# 1. NVIDIA 驱动
DRIVER_FILE="NVIDIA-Linux-x86_64-${DRIVER_VERSION}.run"
DRIVER_URL="https://download.nvidia.com/XFree86/Linux-x86_64/${DRIVER_VERSION}/${DRIVER_FILE}"
DRIVER_BACKUP_URL="https://file.mir.blsc.cn/deploy/NVIDIA/driver/${DRIVER_FILE}"

# 2. Fabric Manager
if [ "$MAJOR_VERSION" -lt 580 ]; then
    FABRIC_FILE="nvidia-fabricmanager-${MAJOR_VERSION}_${DRIVER_VERSION}-1_amd64.deb"
else
    FABRIC_FILE="nvidia-fabricmanager_${DRIVER_VERSION}-1_amd64.deb"
fi
FABRIC_URL="https://developer.download.nvidia.com/compute/cuda/repos/${UBUNTU_CODENAME}/x86_64/${FABRIC_FILE}"
FABRIC_BACKUP_URL="https://file.mir.blsc.cn/deploy/NVIDIA/driver/${FABRIC_FILE}"

# 3. CUDA 安装包
CUDA_FILE="cuda_${CUDA_VERSION}_${CUDA_DRIVER_PART}_linux.run"
CUDA_URL="https://developer.download.nvidia.com/compute/cuda/${CUDA_VERSION}/local_installers/${CUDA_FILE}"

# 4. 监控安装脚本
IDS_FILE="ids-bare-metal-mon-installer.gnode.ubuntu.v1.0.10.linux_amd64.sh"
IDS_URL="https://file.mir.blsc.cn/deploy/monitor/${IDS_FILE}"

# ================= 智能下载函数 =================
# 功能：检测下载速度，如果低于阈值则切换备用源
# 参数：$1=主URL, $2=备用URL(可选), $3=输出目录, $4=文件描述
smart_download() {
    local primary_url="$1"
    local backup_url="$2"
    local output_dir="$3"
    local description="$4"
    local filename=$(basename "$primary_url")
    local output_path="$output_dir/$filename"
    local speed_threshold=2000000  # 2MB/s = 2,000,000 bytes/s
    local speed_threshold_mb="2 MB/s"

    # 如果文件已存在，跳过下载
    if [ -f "$output_path" ]; then
        local file_size=$(stat -c%s "$output_path" 2>/dev/null || echo 0)
        local file_size_mb=$((file_size / 1024 / 1024))
        echo "[OK] $description 已存在 (${file_size_mb} MB): $filename"
        return 0
    fi

    echo "[INFO] 开始下载 $description ..."
    echo "       主地址: $primary_url"

    # 如果没有备用地址，直接下载
    if [ -z "$backup_url" ]; then
        echo "[INFO] 正在下载..."
        if wget -c --timeout=30 --tries=3 -P "$output_dir" "$primary_url"; then
            echo "[SUCCESS] 下载成功: $filename"
            return 0
        else
            echo "[ERROR] 下载失败: $filename"
            return 1
        fi
    fi

    # 有备用地址时，进行速度检测
    wget -c --timeout=30 --tries=2 -P "$output_dir" "$primary_url" 2>&1 | tee /tmp/wget_download.log &
    local wget_pid=$!

    local prev_size=0
    local check_count=0
    local max_checks=6

    while kill -0 $wget_pid 2>/dev/null; do
        sleep 5
        check_count=$((check_count + 1))

        local current_size=$(stat -c%s "$output_path" 2>/dev/null || echo 0)
        local speed=$(( (current_size - prev_size) / 5 ))
        local speed_kb=$((speed / 1024))

        echo "[DEBUG] 当前下载速度: ${speed_kb} KB/s ($((current_size / 1024 / 1024)) MB 已下载)"

        if [ $speed -lt $speed_threshold ] && [ $check_count -ge 3 ]; then
            echo "[WARN] 下载速度低于 ${speed_threshold_mb}，切换到备用地址..."
            echo "       备用地址: $backup_url"

            kill $wget_pid 2>/dev/null || true
            wait $wget_pid 2>/dev/null || true
            rm -f "$output_path"

            echo "[INFO] 正在从备用地址下载..."
            if wget -c -P "$output_dir" "$backup_url"; then
                echo "[SUCCESS] 从备用地址下载成功!"
                return 0
            else
                echo "[ERROR] 备用地址下载也失败。"
                return 1
            fi
        fi

        prev_size=$current_size

