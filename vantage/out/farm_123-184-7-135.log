#!/bin/bash

# 监控 /data 目录容量增长速度（MB/s）
INTERVAL=10          # 监控间隔（秒）
MOUNT_POINT="/shuju/back_data"  # 要监控的挂载点
LOG_FILE="/tmp/disk_growth.log"  # 可选日志文件
TOTAL_SIZE=9696052   # 传输总数据量（MB）

# 初始化前一次数据
prev_avail=$(df -BM --output=avail "$MOUNT_POINT" | tail -n 1 | tr -d 'M')
prev_time=$(date +%s)

# 计算已传输数据量
transferred=0

echo "开始监控 $MOUNT_POINT 容量变化（单位：MB/s）"
echo "时间戳           可用空间(MB)   变化量(MB)  速度(MB/s)   剩余数据量(MB)   传输进度(%)"

while true; do
    # 获取当前数据
    curr_avail=$(df -BM --output=avail "$MOUNT_POINT" | tail -n 1 | tr -d 'M')
    curr_time=$(date +%s)
    
    # 计算变化量
    delta_avail=$((prev_avail - curr_avail))  # 注意：可用空间减少表示数据增长
    time_diff=$((curr_time - prev_time))
    
    # 计算速度（避免除以0）
    if [ $time_diff -gt 0 ]; then
        speed=$(echo "scale=2; $delta_avail / $time_diff" | bc)
    else
        speed=0
    fi
    
    # 更新已传输数据量
    transferred=$((transferred + delta_avail))
    
    # 计算剩余数据量和传输进度
    remaining=$((TOTAL_SIZE - transferred))
    if [ $remaining -lt 0 ]; then
        remaining=0
    fi
    progress=$(echo "scale=2; $transferred / $TOTAL_SIZE * 100" | bc)
    
    # 输出结果（带时间戳）
    printf "%s  %12d  %12d  %8.2f  %12d  %8.2f%%\n" \
        "$(date '+%Y-%m-%d %H:%M:%S')" \
        "$curr_avail" \
        "$delta_avail" \
        "$speed" \
        "$remaining" \
        "$progress"
    
    # 可选：写入日志文件
    if [ -n "$LOG_FILE" ]; then
        printf "%s,%d,%d,%.2f,%d,%.2f\n" \
            "$(date '+%Y-%m-%d %H:%M:%S')" \
            "$curr_avail" \
            "$delta_avail" \
            "$speed" \
            "$remaining" \
            "$progress" >> "$LOG_FILE"
    fi
    
    # 更新前一次数据
    prev_avail=$curr_avail
    prev_time=$curr_time
    
    sleep $INTERVAL
done

