#!/bin/bash

CHECK_LIST(){
    CHECK_SYSTEM(){
        Machine_Information(){
            echo "[ Machine_Information ]"
            # 获取系统序列号
            serial_number=$(dmidecode -s system-serial-number)

            # 获取主机名
            host_name=$(hostname)

            # 获取eth8x的IP地址，排除inet6地址
            ip_address=$(ip addr show ens19np0 | grep inet | grep -v inet6 | awk '{print$2}' | cut -d/ -f1)


            # 获取NVIDIA GPU详情并格式化输出，确保每行GPU信息后有逗号和新行
            nvidia_details=$(nvidia-smi --query-gpu=index,gpu_serial --format=csv,noheader,nounits | awk -F ',' '{if(NR>1) printf(",\n"); printf$1":"$2}')


            # 将所有详情合并成一行，以逗号分隔，并确保GPU详情前后有双引号
            echo "$serial_number,$host_name,$ip_address,\"$nvidia_details\""
            echo "-----------------------------------------------------------------"

        }

        Network_Rdma_Status(){

            if ibdev2netdev | grep -i down|grep -vE 'eth9x|eth10x' > /dev/null; then
                echo -e "[ network_ibdev2netdev ] \e[31munhealth\e[0m"
                ibdev2netdev | grep -i down
            else
                echo -e "[ network_ibdev2netdev ] \e[32mhealth\e[0m"
            fi

            echo "-----------------------------------------------------------------"
        }

        Network_Hardware_Status(){

            pcie_downgraded_output(){
                cx_type=$(ibdev2netdev -v|grep 'NVIDIA ConnectX'|awk -F 'Adapter' '{print $1}'|awk '{print $NF}' |sort -n |uniq -c|sort -nr|head -n 1|awk '{print $2}')
                output=$(ibdev2netdev  -v |grep $cx_type |awk '{print $1}')
                read -r -d '' -a array <<< "$output"
                for element in "${array[@]}"
                do
                    lspci -vvv -s $element -i limit | grep down
                done
            }

            Plan_B_mlnx_tune(){
               mlnx_tune |grep Warning|grep 'PCI Width'
            }

            if [ $(pcie_downgraded_output|wc -l) -ne 0 ]; then
                    echo -e "[ network_pcie_downgraded ] \e[31munhealth\e[0m"
                    pcie_downgraded_output
            else
                    echo -e "[ network_pcie_downgraded ] \e[32mhealth\e[0m"
            fi
            echo "-----------------------------------------------------------------"

        }
        Compute_CPU_Performance(){
            cpu_mode=$(cpupower frequency-info | grep 'The governor' | awk -F '"' '{print$2}')
            if [ "$cpu_mode" != "performance" ]; then
                echo -e "[ compute_cpu_performance ] \e[31munhealth\e[0m"
                echo $cpu_mode
            else
                echo -e "[ compute_cpu_performance ] \e[32mhealth\e[0m"
            fi
            echo "-----------------------------------------------------------------"
        }
        Compute_CPU_IDLE(){
            cpu_idle_disable_number=$(cpupower idle-info|grep 'POLL'|grep -v 'Flags'|grep 'DISABLED'|wc -l)
            if [[ $cpu_idle_disable_number -ne 1 ]]; then
                echo -e "[ compute_cpu_idle ] \e[31munhealth\e[0m"
            else
                echo -e "[ compute_cpu_idle ] \e[32mhealth\e[0m"
            fi
            echo "-----------------------------------------------------------------"
        }

        Machine_Information
        Network_Rdma_Status
        Network_Hardware_Status
        #Compute_CPU_Performance
        #Compute_CPU_IDLE
    }

    CHECK_GPU(){

        Compute_GPU_Persistence_Mode(){
            enable_persistence_mode_number=$(nvidia-smi -q | grep -i "Persistence Mode"|grep Enabled|wc -l)
            if [[ $enable_persistence_mode_number -ne 8 ]]; then
                echo -e "[ compute_gpu_persistence_mode ] \e[31munhealth\e[0m"
            else
                echo -e "[ compute_gpu_persistence_mode ] \e[32mhealth\e[0m"
            fi
            echo "-----------------------------------------------------------------"
        }

        Compute_GPU_NV_PEER_MEM(){
            lsmod_nv_peer_mem_nember=$(lsmod | grep -i 'nv' | grep -i peer | grep -i mem|wc -l)
            if [[ $lsmod_nv_peer_mem_nember -eq 0 ]]; then
