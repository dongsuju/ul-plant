#!/bin/bash
export http_proxy=http://10.29.1.201:3128
export https_proxy=http://10.29.1.201:3128

DOWNLOAD_DIR="/ssd/models"
mkdir -p "$DOWNLOAD_DIR"

# 成功和失败计数器
success_count=0
fail_count=0
failed_models=()

download_model() {
    local url="$1"
    local model_name="$2"
    local filename=$(basename "$url")
    
    # 处理包含查询参数的URL
    if [[ "$filename" == *"?"* ]]; then
        filename=$(echo "$filename" | cut -d'?' -f1)
    fi
    
    echo "������ 开始下载: $model_name"
    echo "������ 文件: $filename"
    echo "������ URL: $url"
    echo "---"
    
    # 修复：确保 aria2c 命令在一行内完整执行
    aria2c --all-proxy="$http_proxy" --dir="$DOWNLOAD_DIR" --out="$filename" --max-tries=5 --retry-wait=10 --timeout=60 --max-connection-per-server=16 --split=16 --continue=true --check-certificate=false --summary-interval=30 "$url"
    
    if [ $? -eq 0 ]; then
        echo "✅ 成功: $model_name → $filename"
        ((success_count++))
        return 0
    else
        echo "❌ 失败: $model_name"
        ((fail_count++))
        failed_models+=("$model_name")
        return 1
    fi
    echo
}

# 执行下载
start_time=$(date)
echo "������ 开始下载 Wan 系列模型..."
echo "⏰ 开始时间: $start_time"
echo "������ 下载目录: $DOWNLOAD_DIR"
echo

# 下载列表
download_model "https://huggingface.co/Kijai/WanVideo_comfy/resolve/main/umt5-xxl-enc-bf16.safetensors" "umt5-xxl编码器模型"
download_model "https://huggingface.co/lightx2v/Wan2.1-I2V-14B-480P-StepDistill-CfgDistill-Lightx2v/resolve/main/loras/Wan21_I2V_14B_lightx2v_cfg_step_distill_lora_rank64.safetensors" "Wan2.1 I2V LoRA模型"
download_model "https://huggingface.co/Kijai/WanVideo_comfy/resolve/main/Wan2_1_VAE_bf16.safetensors" "Wan2.1 VAE模型"
download_model "https://huggingface.co/Kijai/WanVideo_comfy/resolve/main/InfiniteTalk/Wan2_1-InfiniTetalk-Single_fp16.safetensors" "InfiniteTalk模型"
download_model "https://huggingface.co/NJU-Jet/SageAttention211/resolve/main/SageAttention.tar" "SageAttention模块"
download_model "https://huggingface.co/Kijai/WanVideo_comfy_fp8_scaled/resolve/main/HuMo/Wan2_1-HuMo-14B_fp8_e5m2_scaled_KJ.safetensors" "HuMo人体运动模型"
download_model "https://huggingface.co/Kijai/WanVideo_comfy/resolve/main/Lynx/lynx_lite_resampler_fp32.safetensors" "Lynx Lite重采样器"
download_model "https://huggingface.co/Kijai/WanVideo_comfy/resolve/main/Lightx2v/lightx2v_I2V_14B_480p_cfg_step_distill_rank128_bf16.safetensors" "Lightx2v I2V模型"
download_model "https://huggingface.co/Kijai/WanVideo_comfy/resolve/main/Lynx/Wan2_1-T2V-14B-Lynx_lite_ip_layers_fp16.safetensors" "Lynx Lite IP层"
download_model "https://huggingface.co/Kijai/WanVideo_comfy/resolve/main/Lynx/Wan2_1-T2V-14B-Lynx_full_ref_layers_fp16.safetensors" "Lynx Full参考层"
download_model "https://huggingface.co/Kijai/WanVideo_comfy/resolve/main/HuMo/whisper_large_v3_encoder_fp16.safetensors" "Whisper语音编码器"
download_model "https://huggingface.co/vrgamedevgirl84/Wan14BT2VFusioniX/resolve/main/Wan14Bi2vFusioniX_fp16.safetensors" "Wan FusioniX模型"

# 最终总结
end_time=$(date)
echo
echo "========================================"
echo "������ 下载任务完成总结"
echo "========================================"
echo "✅ 成功: $success_count 个模型"
echo "❌ 失败: $fail_count 个模型"
echo "⏰ 开始: $start_time"
echo "⏰ 结束: $end_time"
echo "������ 位置: $DOWNLOAD_DIR"

if [ $fail_count -gt 0 ]; then
    echo
    echo "失败的模型:"
    for model in "${failed_models[@]}"; do
        echo "  ❌ $model"
    done
    echo "������ 提示: 可以重新运行脚本尝试重新下载失败的模型"
fi

echo
echo "下载的文件列表:"
ls -lh "$DOWNLOAD_DIR" | grep -E "\.(safetensors|tar)$"

# 显示总文件大小
echo
echo "������ 总文件大小:"
du -sh "$DOWNLOAD_DIR"
