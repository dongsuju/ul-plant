#!/bin/bash
set -e
# 定义目标服务器信息
REMOTE_USER="root"
REMOTE_HOST="172.16.21.76"
REMOTE_PORT="22"
SSH_KEY="/root/.ssh/id_rsa"  # 添加密钥路径

# 本地目录和远程目标目录的映射
SRC_HOME="/ssd"
DEST_HOME="/ssd"

# 定义要拷贝的主目录
DIRECTORIES=("$SRC_HOME")
REMOTE_DIRECTORIES=("$DEST_HOME")

# 遍历每个主目录，启动8个子进程
for idx in ${!DIRECTORIES[@]}; do
    SRC_DIR="${DIRECTORIES[$idx]}"
    DEST_DIR="${REMOTE_DIRECTORIES[$idx]}"

    # 获取要同步的子目录和文件列表，并分成8份
    SUBDIRS=($(ls "$SRC_DIR"))
    CHUNK_SIZE=$(( (${#SUBDIRS[@]} + 7) / 8 ))

    for ((i = 0; i < ${#SUBDIRS[@]}; i += CHUNK_SIZE)); do
        # 取出一个分块
        CHUNK=("${SUBDIRS[@]:i:CHUNK_SIZE}")

        # 构建 rsync 过滤参数，包含当前分块的子目录
        EXCLUDE_PATTERNS=()
        for SUBDIR in "${SUBDIRS[@]}"; do
            if [[ ! " ${CHUNK[@]} " =~ " $SUBDIR " ]]; then
                EXCLUDE_PATTERNS+=("--exclude=$SUBDIR")
            fi
        done

        # 启动一个 rsync 进程，拷贝当前分块内容
        rsync -avz --info=flist2,progress2,stats2 --partial --append-verify \
            -e "ssh -i $SSH_KEY -p $REMOTE_PORT" "${EXCLUDE_PATTERNS[@]}" "$SRC_DIR/" "$REMOTE_USER@$REMOTE_HOST:$DEST_DIR" &
    done
done

# 等待所有 rsync 进程完成
wait

echo "数据同步完成！"
