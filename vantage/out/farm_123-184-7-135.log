#nodes=("g0001" "g0005" "g0002" "g0006" "g0003" "g0011" "g0004" "g0012")
nodes=("g0008" "g0007")
# 遍历节点，按每两台一组运行nccl-test
for ((i=0; i<${#nodes[@]}; i+=2)); do
  node1=${nodes[$i]}
  node2=${nodes[$i+1]}
  
  # 在每一对节点之间运行NCCL测试命令
  echo "Running NCCL test between $node1 and $node2"
  
  # 这里是实际运行NCCL测试的命令
  # 假设你可以通过SSH运行nccl-test（具体命令根据实际情况修改）

# 设置环境变量
ucx_home=/data/apps/ucx
openmpi_home=/data/apps/openmpi
nccl_home=/data/apps/nccl/build
nccl_tests_home=/data/apps/nccl-tests/build
cuda_home=/data/apps/cuda/12.4.0
export PATH=${ucx_home}/bin:${openmpi_home}/bin:${cuda_home}/bin:${nccl_tests_home}:$PATH
export LD_LIBRARY_PATH=${ucx_home}/lib:${openmpi_home}/lib:${cuda_home}/lib64:${nccl_home}/lib:$LD_LIBRARY_PATH
export CPATH=${ucx_home}/include:${openmpi_home}/include:${cuda_home}/include:${nccl_home}/inclue:$CPATH
export NCCL_ALGO=Ring

log_file="./1to1result/nccl_test_${node1}_${node2}.log"

/data/apps/openmpi/bin/mpirun --allow-run-as-root -H $node1:8,$node2:8 \
       -x LD_LIBRARY_PATH -x PATH -x NCCL_DEBUG=info -x NCCL_NVLS_ENABLE=0  -x NCCL_IB_HCA=mlx5_0:1,mlx5_1:1,mlx5_2:1,mlx5_6:1,mlx5_7:1,mlx5_8:1,mlx5_9:1,mlx5_10:1 \
       -x UCX_NET_DEVICES=mlx5_0:1,mlx5_1:1,mlx5_2:1,mlx5_6:1,mlx5_7:1,mlx5_8:1,mlx5_9:1,mlx5_10:1 \
       -x NCCL_SOCKET_IFNAME=bond0 -x NCCL_IB_QPS_PER_CONNECTION=4 -x NCCL_IB_DISABLE=0 \
       -x NCCL_ALGO=Ring /data/apps/nccl-tests/build/all_reduce_perf -b 8 -e 16G -f 2 -g 1 >> $log_file 2>&1 &

done
===== /root/conf/IB_HCA_check.sh
#!/bin/bash

# 节点范围 (33-64)
start=33
end=64

# 严格定义的设备列表（按数字顺序）
declare -a target_devices=(
mlx5_0 mlx5_1 mlx5_2 mlx5_3 
mlx5_7 mlx5_8 mlx5_9 mlx5_10
)

for ((i=start; i<=end; i++)); do
    node=$(printf "gpu%g" $i)
    echo -e "\n\e[1;34m========== Checking node $node ==========\e[0m"
    
    # 获取原始IB信息（保留错误输出）
    raw_output=$(ssh -o ConnectTimeout=5 -T kgzs@$node "ibstat" 2>&1)
    ssh_status=$?
    
    # SSH连接检查
    if [ $ssh_status -ne 0 ]; then
        echo -e "\e[31mSSH Error $ssh_status: ${raw_output}\e[0m"
        continue
    fi
    
    # 使用关联数组存储设备状态
    declare -A device_state
    declare -A device_rate
    
    # 初始化所有设备为未找到
    for dev in "${target_devices[@]}"; do
        device_state["$dev"]="NotExist"
        device_rate["$dev"]="N/A"
    done

    # 解析输出
    current_ca=""
    while IFS= read -r line; do
        # 提取CA名称
        if [[ $line =~ ^CA\ \'(.+)\' ]]; then
            current_ca="${BASH_REMATCH[1]}"
            continue
        fi
        
        # 仅处理目标设备
        if [[ " ${target_devices[@]} " =~ " $current_ca " ]]; then
            if [[ $line =~ State:\ (.+) ]]; then
                device_state["$current_ca"]="${BASH_REMATCH[1]}"
            elif [[ $line =~ Rate:\ (.+) ]]; then
                device_rate["$current_ca"]="${BASH_REMATCH[1]}"
            fi
        fi
    done <<< "$raw_output"

    # 按定义顺序输出
    for dev in "${target_devices[@]}"; do
        state=${device_state["$dev"]}
        rate=${device_rate["$dev"]}
        
        # 颜色标注异常状态
        color_code="32m"  # 绿色
        [[ $state != "Active" ]] && color_code="31m"  # 红色
        
        printf "\e[34m%-7s\e[0m: State=\e[%s%-6s\e[0m Rate=\e[36m%4s Gb/s\e[0m\n" \
               "$dev" "$color_code" "$state" "$rate"
    done
    
    unset device_state device_rate
done
===== /root/conf/acs_check.sh
for BDF in `lspci -d "*:*:*" | awk '{print $1}'`; do
  # 检查是否支持ACS
  sudo setpci -v -s ${BDF} ECAP_ACS+0x6.w > /dev/null 2>&1
  if [ $? -ne 0 ]; then
    continue
  fi
  # 读取ACS寄存器值
  acs_value=$(sudo setpci -v -s ${BDF} ECAP_ACS+0x6.w)
  echo "Device ${BDF} ACS setting: ${acs_value}"
done
===== /root/conf/b200_ceph_storage_mount.sh
#!/bin/bash
#存储开通流程】 
#1. @刘美琪将存储开通需求提给宇超团队的@刘正章。
#2. @刘正章找田磊开通存储，田磊开通后将存储key交付给@刘正章并协助进行存储的挂载。
#3. 正章后期遇到任何存储使用上的问题找田磊解决。
#
#【CephFS存储挂载步骤
#GPU计算节点通常都会有8个400Gb网口和2个200Gb网口。其中200Gb网口的命名通常是ens120f0np0和ens120f1np1。连接到CephFS存储的网口就使用这两个200Gb网口中的一个。由于CephFS存储服务端使用的是0号口，与福宝约定统一使用ens120f0np0这个口。
#1. 执行ip addr show dev ens120f0np0命令找到当前GPU计算节点ens120f0np0网口的IP地址。比如是10.27.5.63
#2. 设定该网口到存储服务端的路由
## ip route add 10.24.8.0/24 dev ens120f0np0 via 10.27.5.63
#3.如果B200集群有CPU节点
#执行ibdev2netdev 找到mlx CA口对应的200Gb网络接口名称，比如:ens18f1np1
#ip route add 10.24.8.0/24 dev ens18f1np1 via 10.24.32.32(本机ip);ping -I 10.24.32.32(本机ip)  10.24.8.48(存储节点内网ip)
#3. 使用ping命令测试该节点到存储端网络连通性。
## ping -I 10.27.5.63  10.24.8.48
#可ping通即表示网络没有问题。再执行如下文档步骤挂载存储
#https://ktdmyj58g1.feishu.cn/docx/VleHdCK3hoPzsIxKa8Mc6ExjnBc?from=from_copylink
#ceph(非zw3)的挂载示例:mount -t ceph :/ /share -o recover_session=clean,conf=/etc/ceph/ceph.conf,name=cfs06,fs=cfs06
#zw3的挂载示例:mount -t ceph :/ /share -o recover_session=clean,conf=/etc/ceph/zw3.conf,name=zw3cfs01,fs=zw3cfs01
===== /root/conf/batch_install.sh
#!/bin/bash
#set -euo pipefail

# ========== 配置 ==========
HOSTLIST="${1:-hostlist2}"
JOBS=16
SCP_USER_SSH_TIMEOUT=60
SCP_PKG_TIMEOUT=600
SSH_EXEC_TIMEOUT=3600
LOG_DIR="./deploy_logs"
REMOTE_USER="ubuntu"

export LOG_DIR
export REMOTE_USER
export PARALLEL="--no-notice"

# ========== 自动安装 parallel ==========
if ! command -v parallel >/dev/null 2>&1; then
    echo "⚠️  GNU parallel 未安装，正在自动安装..."
    if sudo -n true 2>/dev/null; then
        sudo apt update -y >/dev/null 2>&1
        sudo apt install -y parallel >/dev/null 2>&1
    else
        echo "������ 需要 sudo 权限安装 parallel，请输入密码："
        sudo apt update -y
        sudo apt install -y parallel
    fi
    if ! command -v parallel >/dev/null 2>&1; then
        echo "❌ 自动安装失败，请手动运行：sudo apt install parallel"
        exit 1
    fi
    echo "✅ GNU parallel 已成功安装。"
fi

# ========== 部署函数 ==========
deploy_node() {
    local ip="$1"
    local log_dir="${LOG_DIR:-./deploy_logs}"
    local remote_user="${REMOTE_USER:-ubuntu}"
    local remote_home="/home/$remote_user"
    local scp_user_ssh_timeout="${SCP_USER_SSH_TIMEOUT:-60}"
    local scp_pkg_timeout="${SCP_PKG_TIMEOUT:-600}"
    local ssh_exec_timeout="${SSH_EXEC_TIMEOUT:-3600}"
    local log="$log_dir/${ip}.log"
    
    mkdir -p "$log_dir"
    echo "[+] Starting setup on $ip at $(date)" | tee "$log"

    # === 0. 检查内网 APT 源连通性 (100.100.12.17:8080) ===
    #echo "[→] Checking internal APT repo connectivity on $ip..." >> "$log"
    #if ! timeout 30 ssh -o ConnectTimeout=30 -o StrictHostKeyChecking=no "${remote_user}@${ip}" \
    #    'timeout 10 bash -c "cat < /dev/null > /dev/tcp/100.100.12.17/8080" 2>/dev/null'; then
    #    echo "[✗] FAILED: $ip - Internal APT repo (100.100.12.17:8080) is NOT reachable!" | tee -a "$log"
    #    echo "$ip" >> "$log_dir/failed.list"
    #    return 1
    #fi
    #echo "[+] APT repo connectivity OK on $ip" >> "$log"

    # === 4. 智能上传安装包（基于 md5sum 跳过）===
    packages=(
        "NVIDIA-Linux-x86_64-570.133.20.run"
        "MLNX_OFED_LINUX-24.10-2.1.8.0-ubuntu22.04-x86_64.tgz"
        "cuda_12.8.0_570.86.10_linux.run"
        "nvidia-fabricmanager-570_570.133.20-1_amd64.deb"
    )

    for pkg in "${packages[@]}"; do
        if [ ! -f "$pkg" ]; then
            echo "[✗] FAILED: $ip - Local package '$pkg' not found" | tee -a "$log"
            echo "$ip" >> "$log_dir/failed.list"
            return 1
        fi

        local remote_pkg_path="${remote_home}/${pkg}"
        local local_md5
        local remote_md5=""

        local_md5=$(md5sum "$pkg" | cut -d' ' -f1)

        # 获取远程文件的 md5（如果存在）
        if timeout 30 ssh -o ConnectTimeout=30 -o StrictHostKeyChecking=no "${remote_user}@${ip}" \
            "[ -f '${remote_pkg_path}' ] && md5sum '${remote_pkg_path}' | cut -d' ' -f1" 2>/dev/null; then
            remote_md5=$(timeout 30 ssh -o ConnectTimeout=30 -o StrictHostKeyChecking=no "${remote_user}@${ip}" \
                "[ -f '${remote_pkg_path}' ] && md5sum '${remote_pkg_path}' | cut -d' ' -f1" 2>/dev/null)
        fi

        if [[ "$remote_md5" == "$local_md5" ]]; then
            echo "[=] Skipping $pkg (MD5 matches)" >> "$log"
            continue
        else
            echo "[→] Uploading $pkg to $ip ..." >> "$log"
            if ! timeout "$scp_pkg_timeout" scp -o ConnectTimeout=30 -o StrictHostKeyChecking=no \
                "$pkg" "${remote_user}@${ip}:${remote_home}/" >> "$log" 2>&1; then
                echo "[✗] FAILED: $ip - Failed to upload $pkg" | tee -a "$log"
                echo "$ip" >> "$log_dir/failed.list"
                return 1
            fi
        fi
    done

    # === 5. 上传 conf 目录 ===
    if ! timeout "$scp_pkg_timeout" scp -o ConnectTimeout=30 -o StrictHostKeyChecking=no \
        -r conf "${remote_user}@${ip}:${remote_home}/" >> "$log" 2>&1; then
        echo "[✗] FAILED: $ip - Failed to upload conf directory" | tee -a "$log"
        echo "$ip" >> "$log_dir/failed.list"
        return 1
    fi
    echo "[+] Packages and conf uploaded (or skipped) on $ip" >> "$log"

    # === 6. 执行安装脚本 ===
    if ! timeout "$ssh_exec_timeout" ssh -o ConnectTimeout=30 -o StrictHostKeyChecking=no "${remote_user}@${ip}" "
        set -euo pipefail
        cd /home/ubuntu
        ./conf/grub.sh
	sudo dpkg --configure -a
        sudo apt update -y
        sudo ./conf/disableupdate.sh
        sudo ./conf/disablenouveau.sh
        sudo ./conf/cpu_performance.sh
        sudo ./conf/install_build_essential.sh
