===== /root/conf/root_batch_install.sh
#!/bin/bash
set -euo pipefail

# ========== 配置 ==========
HOSTLIST="${1:-hostlist4}"      # 主机列表文件（可命令行传入）
JOBS=8                          # 并发数
SCP_KEY_TIMEOUT=300             # root密钥上传超时（秒）
SCP_USER_SSH_TIMEOUT=60         # user密钥上传超时
SCP_PKG_TIMEOUT=600             # 安装包上传超时
SCP_SUDOERS_TIMEOUT=60          # sudoers文件上传超时
SSH_EXEC_TIMEOUT=3600           # 远程执行超时（1小时）
LOG_DIR="./deploy_logs"         # 日志目录
REMOTE_USER="user"              # 普通用户名（可修改）

# ������ 关键修复：导出变量供 parallel 子进程继承
export LOG_DIR
export REMOTE_USER
export PARALLEL="--no-notice"

# ========== 自动安装 parallel ==========
if ! command -v parallel >/dev/null 2>&1; then
    echo "⚠️  GNU parallel 未安装，正在自动安装..."
    if sudo -n true 2>/dev/null; then
        sudo apt update -y >/dev/null 2>&1
        sudo apt install -y parallel >/dev/null 2>&1
    else
        echo "������ 需要 sudo 权限安装 parallel，请输入密码："
        sudo apt update -y
        sudo apt install -y parallel
    fi
    if ! command -v parallel >/dev/null 2>&1; then
        echo "❌ 自动安装失败，请手动运行：sudo apt install parallel"
        exit 1
    fi
    echo "✅ GNU parallel 已成功安装。"
fi

# ========== 部署函数 ==========
deploy_node() {
    local ip="$1"
    # ������ 防御性：如果变量未传入，使用默认值
    local log_dir="${LOG_DIR:-./deploy_logs}"
    local remote_user="${REMOTE_USER:-user}"
    local remote_home="/home/$remote_user"
    local log="$log_dir/${ip}.log"
    
    mkdir -p "$log_dir"
    echo "[+] Starting setup on $ip at $(date)" | tee "$log"

    # 1. 上传 root SSH 密钥
    if ! timeout "$SCP_KEY_TIMEOUT" scp -o ConnectTimeout=30 -o StrictHostKeyChecking=no \
        -r .ssh-k/* "root@$ip:/root/.ssh" >> "$log" 2>&1; then
        echo "[✗] FAILED: $ip - Root SSH key upload failed" | tee -a "$log"
        echo "$ip" >> "$log_dir/failed.list"
        return 1
    fi

    # 2. 上传 user SSH 配置
    if ! timeout 30 ssh -o ConnectTimeout=30 -o StrictHostKeyChecking=no "root@$ip" \
        "mkdir -p $remote_home/.ssh && chown $remote_user:$remote_user $remote_home/.ssh" >> "$log" 2>&1; then
        echo "[✗] FAILED: $ip - Failed to create $remote_home/.ssh" | tee -a "$log"
        echo "$ip" >> "$log_dir/failed.list"
        return 1
    fi

    for file in authorized_keys config id_rsa id_rsa.pub; do
        if [ ! -f ".ssh-user/$file" ]; then
            echo "[✗] FAILED: $ip - Local file .ssh-user/$file not found" | tee -a "$log"
            echo "$ip" >> "$log_dir/failed.list"
            return 1
        fi
        if ! timeout "$SCP_USER_SSH_TIMEOUT" scp -o ConnectTimeout=30 -o StrictHostKeyChecking=no \
            ".ssh-user/$file" "root@$ip:$remote_home/.ssh/" >> "$log" 2>&1; then
            echo "[✗] FAILED: $ip - Failed to upload .ssh-user/$file" | tee -a "$log"
            echo "$ip" >> "$log_dir/failed.list"
            return 1
        fi
    done

    if ! timeout 30 ssh -o ConnectTimeout=30 -o StrictHostKeyChecking=no "root@$ip" "
        chown -R $remote_user:$remote_user $remote_home/.ssh && \
        chmod 700 $remote_home/.ssh && \
        chmod 600 $remote_home/.ssh/authorized_keys $remote_home/.ssh/config $remote_home/.ssh/id_rsa $remote_home/.ssh/id_rsa.pub
    " >> "$log" 2>&1; then
        echo "[✗] FAILED: $ip - Failed to set user SSH permissions" | tee -a "$log"
        echo "$ip" >> "$log_dir/failed.list"
        return 1
    fi
    echo "[+] User SSH config uploaded to $ip" >> "$log"

    # 3. 上传安装包
    if ! timeout "$SCP_PKG_TIMEOUT" scp -o ConnectTimeout=30 -o StrictHostKeyChecking=no \
        -r conf NVIDIA-Linux-x86_64-570.133.20.run \
           MLNX_OFED_LINUX-24.10-1.1.4.0-ubuntu22.04-x86_64.tgz \
           cuda_12.8.1_570.124.06_linux.run \
           nvidia-fabricmanager-570_570.133.20-1_amd64.deb \
           "root@$ip:/root" >> "$log" 2>&1; then
        echo "[✗] FAILED: $ip - Package upload failed" | tee -a "$log"
        echo "$ip" >> "$log_dir/failed.list"
        return 1
    fi

    # 4. 上传 sudoers 配置
    if ! timeout "$SCP_SUDOERS_TIMEOUT" scp -o ConnectTimeout=30 -o StrictHostKeyChecking=no \
        user-nopasswd "root@$ip:/etc/sudoers.d/user-nopasswd" >> "$log" 2>&1; then
        echo "[✗] FAILED: $ip - Sudoers file upload failed" | tee -a "$log"
        echo "$ip" >> "$log_dir/failed.list"
        return 1
    fi

    if ! timeout 30 ssh -o ConnectTimeout=30 -o StrictHostKeyChecking=no "root@$ip" '
        chmod 440 /etc/sudoers.d/user-nopasswd && \
        visudo -c -f /etc/sudoers.d/user-nopasswd
    ' >> "$log" 2>&1; then
        echo "[✗] FAILED: $ip - Sudoers file invalid or permission error" | tee -a "$log"
        echo "$ip" >> "$log_dir/failed.list"
        return 1
    fi
    echo "[+] Sudoers config uploaded and validated on $ip" >> "$log"

