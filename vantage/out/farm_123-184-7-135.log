# 模式2：批量测试（每64个节点一组）

MODE="batch"  # 可选：pair（按对）或 batch（批量）

if [ "$MODE" == "pair" ]; then
    # 模式1：按对测试（每2个节点一组）
    echo "模式：按对测试（每2个节点一组）"
    for ((i=0; i<${#nodes[@]}; i+=2)); do
        # 如果是最后一个且只剩一个节点，跳过
        if [ $((i+1)) -ge ${#nodes[@]} ]; then
            echo "警告：节点 ${nodes[$i]} 没有配对节点，跳过"
            continue
        fi
        
        node1=${nodes[$i]}
        node2=${nodes[$i+1]}
        
        # 创建日志文件
        log_file="./1to1result/nccl_test_${node1}_${node2}.log"
        
