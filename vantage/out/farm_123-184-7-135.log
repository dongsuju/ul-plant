USER_ACCOUNT="ubuntu"
MOUNT_POINT="/data"
NODE_EXPORTER_PORT=9100
DCGM_EXPORTER_PORT=9400

function INFO(){
        /bin/echo -e "\e[104m\e[97m[INFO]\e[49m\e[39m ${*}"
}
function WARNING(){
        /bin/echo >&2 -e "\e[101m\e[97m[WARNING]\e[49m\e[39m ${*}"
}
function ERROR(){
        /bin/echo >&2 -e "\e[101m\e[97m[ERROR]\e[49m\e[39m ${*}"
}
function CHECK_SUDOERS(){
	R=`cat /etc/sudoers | grep ${USER_ACCOUNT} | wc -l`
	if [ $R -eq 1 ];then
		INFO "sudoers 已经添加${USER_ACCOUNT}用户！"
    else
		ERROR "sudoer 没有添加${USER_ACCOUNT}用户！"
	fi
}
function CHECK_DISK_MOUNT(){
	R=`df -h | grep ${MOUNT_POINT} | wc -l`
	if [ $R -eq 0 ]; then
		ERROR "磁盘没有挂载！"
	else
		MOUNT_DEVICE=`df -h | grep ${MOUNT_POINT}| awk '{print $1}'`
		INFO "磁盘已挂载，挂载设备：${MOUNT_DEVICE}，挂载点：${MOUNT_POINT}"
	fi
}
function CHECH_HOSTS(){
	INFO "当前主机名：$(hostname)"
	R=`cat /etc/hosts | grep $(hostname) | wc -l` 
	if [ $R -eq 0 ]; then
		ERROR "hosts未添加当前主机名和地址绑定！"
	else
		INFO "hosts已添加！"
	fi
}
function CHECK_CPU_MODE(){
	R=`cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>&1`
	if [ $? -eq 0 ];then
		if [ $R == "performance" ]; then
			INFO "CPU已设置性能模式：$R"
		else
			ERROR "当前CPU模式：$R"
		fi
	else
		WARNING "当前环境无法查询 CPU 模式！"
	fi
}
function CHECK_ULIMIT(){
	R=`ulimit -a | grep stack | awk '{print $NF}'`
	if [ $R == "unlimited" ]; then
		INFO "文件描述符已添加！"
	else
		ERROR "文件描述符未设置！"
	fi
}
function CHECK_NOUVEAU(){
	R=`lsmod |grep nouveau | wc -l`
	if [ $R -eq 0 ]; then
		INFO "nouveau 驱动已禁用！"
	else
		ERROR "nouveau 驱动未禁用！"
	fi
}
function CHECK_NVIDIA_DRIVER(){
	if ! command -v "nvidia-smi" >/dev/null 2>&1; then
		ERROR "英伟达驱动未安装！"
	else
		V=`nvidia-smi --version | head -1 | awk '{print $4}'`
		INFO "英伟达驱动已安装，版本：$V"
		R2=`nvidia-smi | grep 'On' | awk '{print $5}' | uniq -c | awk '{print $2}'`
		if [ $R2 == "On" ]; then
			INFO "GPU 持续模式已开启！"
		else
			ERROR "GPU持续模式未开启！"
		fi
	fi
}
function CHECK_NVIDIA_FABRIC_MANAGER(){
	if ! command -v "nv-fabricmanager" >/dev/null 2>&1; then
		WARNING "英伟达Fabric Manager 未安装！"
	else
		R=`systemctl status nvidia-fabricmanager | grep "active (running)" | wc -l`
		if [ $R -eq 0 ]; then
			ERROR "英伟达Fabric Manager 已安装，运行状态异常！"
		else
			INFO "英伟达Fabric Manager 已安装，运行状态正常！"
		fi
	fi
}
function CHECK_CUDA_TOOLKIT(){
	if ! command -v "nvcc" >/dev/null 2>&1; then
		ERROR "CUDA TOOLKIT 未安装！"
	else
		V=`nvcc -V | tail -n 1 | awk '{print $2}'`
		INFO "CUDA TOOLKIT 已安装，版本：$V"
	fi
}
function CHECK_MELLANOX_DRIVER(){
	if ! command -v "ofed_info" >/dev/null 2>&1; then
		ERROR "Mellanox 驱动未检测到！"
	else
		R=`ofed_info | grep -i ibverbs-providers | awk '{print $3}'`
		INFO "Mellanox 驱动已安装，版本：$R"
	fi
}
function CHECK_RC_LOCAL(){
	R=`lsmod | grep nvidia_peermem | wc -l`
	if [ $R -eq 0 ]; then
		ERROR "nvidia_peermem 未加载到内核！"
	else
		INFO "nvidia_peermem 已加载到内核！"
	fi
}
