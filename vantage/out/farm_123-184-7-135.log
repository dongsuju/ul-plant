#!/bin/bash
apt-get install expect -y
apt install python3 python3-pip -y
pip3 install spawn
# 定义目标主机信息
declare -a hosts=(
  "172.16.21.11"
  "172.16.21.34"
  "172.16.21.35"
)

# SSH密码
PASSWORD="ubuntu@"

# 拷贝 .ssh 目录到每个目标主机
