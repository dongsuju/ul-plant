#!/bin/bash
dd if=/dev/zero of=/mnt/IO-test/test.file bs=1M count=1024000
# 通用参数
FILENAME="/mnt/IO-test/test.file"
SIZE="10G"
IODEPTH=16
DIRECT=1
RUNTIME=240
IOENGINE="sync"
GROUP_REPORTING="--group_reporting"
NAME="test"

# 块大小数组
BLOCK_SIZES=("4M" "1M" "4K")
# 并发任务数数组
NUMJOBS_VALUES=(16 32 64 128)
# I/O模式数组
RW_MODES=("write" "read" "rw" "randread" "randwrite" "randrw")

# 输出文件
OUTPUT_FILE="fio_results.log"

# 清空输出文件（如果存在的话）
> $OUTPUT_FILE

# 循环每种块大小
for BS in "${BLOCK_SIZES[@]}"; do
  # 循环每种并发任务数
  for NUMJOBS in "${NUMJOBS_VALUES[@]}"; do
    # 循环每种I/O模式
    for RW in "${RW_MODES[@]}"; do
      # 构建测试名称
      TEST_NAME="${NAME}_${RW}_bs${BS}_numjobs${NUMJOBS}"
      
      # 将测试名称写入文件
      echo "Running test: $TEST_NAME" | tee -a $OUTPUT_FILE
      
      # 执行 fio 测试，并将命令的输出结果追加到文件中
      fio -filename=$FILENAME -iodepth=$IODEPTH -direct=$DIRECT -bs=$BS -size=$SIZE --rw=$RW -numjobs=$NUMJOBS -time_based -runtime=$RUNTIME -ioengine=$IOENGINE $GROUP_REPORTING -name=$TEST_NAME | tee -a $OUTPUT_FILE
    done
  done
done

