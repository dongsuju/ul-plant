  echo "正在拷贝 .ssh 目录到 $ip"
  
  expect << EOF
set timeout 20
spawn scp -r /home/ubuntu/.ssh ubuntu@$ip:/home/ubuntu
expect {
  "yes/no" { send "yes\r"; exp_continue }
  "password:" { send "$PASSWORD\r" }
}
expect eof
EOF

  if [ $? -eq 0 ]; then
    echo "成功拷贝 .ssh 目录到 $ip"
  else
    echo "拷贝 .ssh 目录到 $ip 失败"
  fi
done
