#!/bin/bash

# 设置起始和结束节点编号
START_NODE=35
END_NODE=125

# 遍历节点范围，按规律执行 mpirun 命令
for i in $(seq -f "node%03g" $START_NODE $((END_NODE - 1))); do
    # 获取当前节点和下一个节点
    CURRENT_NODE=$i
    NEXT_NODE=$(printf "node%03d" $((10#${i:4} + 1))) # 自动计算下一个节点编号

    # 生成 mpirun 命令
    CMD="/gpfs01/nccl-tests/openmpi/bin/mpirun -np 2 -H ${CURRENT_NODE}:1,${NEXT_NODE}:1 hostname"
    echo "执行命令: $CMD"

    # 执行命令
    $CMD

    # 检查命令是否成功
    if [ $? -ne 0 ]; then
        echo "命令失败: $CMD"
        exit 1
    fi
done

echo "所有测试完成！"

===== /root/conf/multi_trans.sh
#!/bin/bash
set -eo pipefail

# ----------------------
# 配置参数
# ----------------------
REMOTE_USER="root"
REMOTE_HOST="183.147.142.41"
REMOTE_PORT="10006"
SSH_KEY="/root/.g0016_id_rsa"

SRC_SSD_HOME="/data/group/wenge"                     # 本地父目录（不要带通配符）
DEST_SSD_HOME="/data/group"                    # 远程目标目录

DIRECTORIES=("$SRC_SSD_HOME")            # 要同步的本地目录
REMOTE_DIRECTORIES=("$DEST_SSD_HOME")    # 对应的远程目录
NUM_PROCESSES=16                          # 并发进程数
MAX_RETRIES=3                            # 最大重试次数

# ----------------------
# 初始化变量
# ----------------------
declare -A TOTAL_SIZE                    # 总大小统计
declare -A COMPLETED_SIZE                # 已完成大小统计
TMP_DIR="/tmp/rsync_parallel_$$"         # 临时目录
mkdir -p "$TMP_DIR"

# ----------------------
# 工具函数
# ----------------------
calc_dir_size() {
  local dir="$1"
  du -sb "$dir" | awk '{print $1}'
}

rsync_with_retry() {
  local src_dir="$1"
  local dest_dir="$2"
  local exclude_list=("${@:3}")
  local retry=0
  local exit_code=0
  local progress_log="$TMP_DIR/$(basename "$src_dir").log"

  # 关键修改：计算实际同步的子目录大小（而非父目录）
  local subdir_size=0
  for subdir in "${CHUNK[@]}"; do
    subdir_size=$(( subdir_size + $(calc_dir_size "$src_dir/$subdir") ))
  done

  while [[ $retry -lt $MAX_RETRIES ]]; do
    {
      echo "========== 开始同步: $src_dir (尝试 $((retry+1)) =========="
      rsync -avz --info=progress2,stats2 --partial --append-verify \
        -e "ssh -i '$SSH_KEY' -p $REMOTE_PORT" \
        "${exclude_list[@]}" \
        "$src_dir/" "$REMOTE_USER@$REMOTE_HOST:$dest_dir/" 2>&1
    } | tee "$progress_log"

    exit_code=${PIPESTATUS[0]}

    if [[ $exit_code -eq 0 ]]; then
      # 关键修改：增加实际传输的子目录大小
      COMPLETED_SIZE["$src_dir"]=$(( ${COMPLETED_SIZE["$src_dir"]:-0} + subdir_size ))
      return 0
    else
      echo "[错误] 同步失败 (代码 $exit_code)，10秒后重试..."
      sleep 10
      ((retry++))
    fi
  done

  echo "[严重错误] 同步 $src_dir 失败，已达最大重试次数"
  return 1
}
# ----------------------
# 主流程
# ----------------------
for idx in ${!DIRECTORIES[@]}; do
  SRC_ROOT="${DIRECTORIES[$idx]}"
  DEST_ROOT="${REMOTE_DIRECTORIES[$idx]}"

  echo "正在扫描目录: $SRC_ROOT ..."
  mapfile -t SUBDIRS < <(find "$SRC_ROOT" -maxdepth 1 -mindepth 1 -type d -print0 | xargs -0 -n1 basename)

  TOTAL_SIZE["$SRC_ROOT"]=0
  for subdir in "${SUBDIRS[@]}"; do
    size=$(calc_dir_size "$SRC_ROOT/$subdir")
    TOTAL_SIZE["$SRC_ROOT"]=$(( ${TOTAL_SIZE["$SRC_ROOT"]} + size ))
  done
  echo "总需传输数据: $(numfmt --to=iec <<< ${TOTAL_SIZE["$SRC_ROOT"]})"

  CHUNK_SIZE=$(( ( ${#SUBDIRS[@]} + NUM_PROCESSES - 1 ) / NUM_PROCESSES ))
  for ((i=0; i<${#SUBDIRS[@]}; i+=CHUNK_SIZE)); do
    CHUNK=("${SUBDIRS[@]:i:CHUNK_SIZE}")

    EXCLUDE_LIST=()
