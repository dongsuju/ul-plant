===== /root/conf/fio-parallel.sh
#!/bin/bash

# 定义客户端节点列表
CLIENT_NODES=("g0002" "g0004" "g0005" "g0008" "g0009" "g0010")

# 通用参数
FILENAME="/mnt/IO-test/test.file"
SIZE="10G"
IODEPTH=16
DIRECT=1
RUNTIME=240
IOENGINE="sync"
GROUP_REPORTING="--group_reporting"
NAME="test"

# 块大小数组
BLOCK_SIZES=("4M" "1M" "4K")
# 并发任务数数组
NUMJOBS_VALUES=(16 32 64 128)
# I/O模式数组
RW_MODES=("write" "read" "rw" "randread" "randwrite" "randrw")

# 输出文件
OUTPUT_FILE="fio_distributed_results.log"

# 清空输出文件（如果存在的话）
> $OUTPUT_FILE

# 循环每种块大小
for BS in "${BLOCK_SIZES[@]}"; do
  # 循环每种并发任务数
  for NUMJOBS in "${NUMJOBS_VALUES[@]}"; do
    # 循环每种I/O模式
    for RW in "${RW_MODES[@]}"; do
      # 构建测试名称
      TEST_NAME="${NAME}_${RW}_bs${BS}_numjobs${NUMJOBS}"
      
      # 记录测试信息到日志文件
      echo "Running distributed test: $TEST_NAME" | tee -a $OUTPUT_FILE
      
      # 在每个客户端节点上执行 FIO 测试
      for CLIENT in "${CLIENT_NODES[@]}"; do
        echo "Testing on client: $CLIENT" | tee -a $OUTPUT_FILE
        fio --client=$CLIENT -filename=$FILENAME -iodepth=$IODEPTH -direct=$DIRECT -bs=$BS -size=$SIZE --rw=$RW -numjobs=$NUMJOBS -time_based -runtime=$RUNTIME -ioengine=$IOENGINE $GROUP_REPORTING -name=$TEST_NAME | tee -a $OUTPUT_FILE
      done
    done
  done
done

echo "分布式 FIO 测试完成！" | tee -a $OUTPUT_FILE
