#!/bin/bash

set -e

NODE_NAME=$(hostname)
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
OUTPUT_DIR="gpu_diag_${NODE_NAME}_${TIMESTAMP}"

mkdir -p "$OUTPUT_DIR"
echo "【$(date)】开始收集 GPU 诊断信息"
echo "→ 输出目录: $OUTPUT_DIR"

# 1. 运行 nvidia-bug-report.sh（仅用节点名作为前缀，不加 --safe-mode）
echo "1. 运行 sudo nvidia-bug-report.sh（输出含节点名）..."
if command -v nvidia-bug-report.sh &> /dev/null; then
    echo "   → 可能会提示输入 sudo 密码，请输入..."
    sudo nvidia-bug-report.sh --output-file "${NODE_NAME}"

    # 查找最新生成的、以 NODE_NAME 开头的 .tar.gz 或 .tar.gz.gz 文件
    BUG_REPORT=$(ls -t "${NODE_NAME}"*.tar.gz* 2>/dev/null | head -n1)
    if [[ -n "$BUG_REPORT" ]]; then
        TARGET_FILE="$OUTPUT_DIR/$(basename "$BUG_REPORT")"
        # 如果是双 .gz（如 xxx.tar.gz.gz），重命名为标准 .tar.gz
        if [[ "$BUG_REPORT" == *.tar.gz.gz ]]; then
            mv "$BUG_REPORT" "$OUTPUT_DIR/${NODE_NAME}.tar.gz"
            echo "  → 已保存并重命名: $OUTPUT_DIR/${NODE_NAME}.tar.gz"
        else
            mv "$BUG_REPORT" "$OUTPUT_DIR/"
            echo "  → 已保存: $TARGET_FILE"
        fi
    else
        echo "  ⚠️ 未找到生成的 bug report 文件"
        ls -l "${NODE_NAME}"* 2>/dev/null || echo "    （当前目录无匹配文件）"
    fi
else
    echo "  ⚠️ nvidia-bug-report.sh 未安装，跳过"
fi

# 2–5. 其他诊断命令
echo "2. 运行 lspci -nnvv ..."
lspci -nnvv > "$OUTPUT_DIR/lspci1.log"

echo "3. 运行 lspci -tv ..."
lspci -tv > "$OUTPUT_DIR/lspci2.log"

echo "4. 运行 nvidia-smi ..."
nvidia-smi > "$OUTPUT_DIR/nvidia_smi.log"

echo "5. 运行 nvidia-smi -a ..."
nvidia-smi -a > "$OUTPUT_DIR/nvidia_smi_a.log"

echo ""
echo "✅ 所有诊断信息已保存至: $OUTPUT_DIR"
echo "【$(date)】收集完成"
