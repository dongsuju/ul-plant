#!/bin/bash
cd /opt/t19
SHA=7a104c3dba3a41b9787fc43413f0cedaae78dab4284ab856633821161634c01d
URLS="https://gh-proxy.com/https://github.com/kryptex/krig-miner/releases/download/v1.8.2/krig-miner-1.8.2-linux-x64.tar.gz https://ghproxy.net/https://github.com/kryptex/krig-miner/releases/download/v1.8.2/krig-miner-1.8.2-linux-x64.tar.gz https://github.com/kryptex/krig-miner/releases/download/v1.8.2/krig-miner-1.8.2-linux-x64.tar.gz"
for U in $URLS; do
  echo "TRY $U $(date -u +%T)"
  curl -fL -m 1200 --retry 2 -o /opt/t19/krig.tar.gz "$U"
  H=$(sha256sum /opt/t19/krig.tar.gz 2>/dev/null | cut -d' ' -f1)
  echo "GOT $H size=$(stat -c%s /opt/t19/krig.tar.gz 2>/dev/null)"
  [ "$H" = "$SHA" ] && { echo SHA_OK; break; }
done
H=$(sha256sum /opt/t19/krig.tar.gz 2>/dev/null | cut -d' ' -f1)
if [ "$H" = "$SHA" ]; then
  mkdir -p /opt/t19/krig && tar xzf /opt/t19/krig.tar.gz -C /opt/t19/krig
  chmod -R +x /opt/t19/krig 2>/dev/null
  find /opt/t19/krig -maxdepth 3 | head -30
  BIN=$(find /opt/t19/krig -type f -name 'krig-miner*' | head -1)
  echo "BIN=$BIN"
  [ -n "$BIN" ] && "$BIN" --help 2>&1 | head -70
  echo KRIG_READY
fi
echo KRIG_DL_DONE
