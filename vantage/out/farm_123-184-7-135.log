#!/bin/bash
#格式化盘，包括格式化分区，谨慎操作
sudo wipefs --all /dev/nvme[0-3]n1
sudo mdadm --create --verbose /dev/md0 --level=10 --raid-device=4 /dev/nvme[0-3]n1
#这里的--raid-device=4表示有4块盘，/dev/nvme[0-3]n1表示盘所在的分区名。
sudo mkfs.ext4 /dev/md0 
sudo mkdir /ssd 

# 获取/dev/md0的UUID
MD0_UUID=$(sudo blkid -s UUID -o value /dev/md0)
echo "获取到/dev/md0的UUID: $MD0_UUID"

# 使用UUID挂载
sudo mount UUID="$MD0_UUID" /ssd

# 配置rc.local自动挂载
if ! grep -q "mount.*$MD0_UUID" /etc/rc.local; then
    echo "添加挂载命令到/etc/rc.local"
    
    # 在最后一个非空行之后插入
    sudo sed -i -e '/^[[:space:]]*$/d' -e '$a\' /etc/rc.local
    echo "mount UUID=\"$MD0_UUID\" /ssd" | sudo tee -a /etc/rc.local
else
    echo "挂载命令已存在于/etc/rc.local中"
fi
# 配置mdadm
mdadm --detail --scan | sudo tee -a /etc/mdadm/mdadm.conf

# 更新initramfs
sudo update-initramfs -u

cat /proc/mdstat
echo 200000000 | sudo tee /proc/sys/dev/raid/speed_limit_min
echo 400000000 | sudo tee /proc/sys/dev/raid/speed_limit_max

echo "RAID10配置完成！"
echo "设备UUID: $MD0_UUID"
echo "挂载点: /ssd"
echo "已配置开机自动挂载到/etc/rc.local"
