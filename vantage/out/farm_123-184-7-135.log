#!/bin/bash

# 等待网络服务就绪
sleep 5

CONFIG_FILE="/etc/netplan/00-installer-config.yaml"
BACKUP_FILE="/usr/local/bin/00-installer-config.yaml.bak"
MODIFIED_FILE="/usr/local/bin/00-installer-config.yaml.modified"

# 记录日志
exec > >(tee -a /tmp/modified_yaml.log) 2>&1
echo "===== 脚本开始执行: $(date) ====="

# 1. 创建备份
echo "正在备份原始配置文件..."
cp "$CONFIG_FILE" "$BACKUP_FILE"
echo "√ 原始配置已备份至: $BACKUP_FILE"

# 2. 创建可修改副本
cp "$BACKUP_FILE" "$MODIFIED_FILE"

# 3. 执行修改
echo "正在解析配置文件..."

# 获取当前bond下的接口名称（更健壮的解析方式）
current_interfaces=($(awk '/bonds:/{flag=1} flag && /interfaces:/{getline; getline; print $2; getline; print $2; exit}' "$MODIFIED_FILE"))

if [ ${#current_interfaces[@]} -ne 2 ]; then
    echo "错误：无法确定bond接口配置，当前配置: ${current_interfaces[*]}" >&2
    echo "尝试备用解析方式..."
    current_interfaces=($(grep -A5 "interfaces:" "$MODIFIED_FILE" | grep -E "^\s{4,6}-" | awk '{print $2}' | head -2))
    
    if [ ${#current_interfaces[@]} -ne 2 ]; then
        echo "备用解析也失败，找到的接口: ${current_interfaces[*]}" >&2
        exit 1
    fi
fi

echo "检测到接口: ${current_interfaces[0]} 和 ${current_interfaces[1]}"

# 修改1: eth0 → bond0
sed -i '/bonds:/,/^[^ ]/s/eth0:/bond0:/' "$MODIFIED_FILE"

# 修改2: bond接口改为eth0/eth1
sed -i "/interfaces:/,/^[^ ]/s/- ${current_interfaces[0]}/- eth0/" "$MODIFIED_FILE"
sed -i "/interfaces:/,/^[^ ]/s/- ${current_interfaces[1]}/- eth1/" "$MODIFIED_FILE"

# 修改3: ethernets部分接口改名
sed -i "s/^    ${current_interfaces[0]}:/    eth0:/" "$MODIFIED_FILE"
sed -i "s/^    ${current_interfaces[1]}:/    eth1:/" "$MODIFIED_FILE"

# 4. 应用配置
echo "正在应用新配置..."
if cp "$MODIFIED_FILE" "$CONFIG_FILE"; then
    echo "配置文件修改内容:"
    diff -u "$BACKUP_FILE" "$CONFIG_FILE" || true
    
    if netplan apply; then
        echo "√ 配置已成功更新并应用"
        echo "当前生效配置:"
        cat "$CONFIG_FILE"
    else
        echo "错误：netplan应用失败，已恢复原始配置" >&2
        cp "$BACKUP_FILE" "$CONFIG_FILE"
        exit 1
    fi
else
    echo "错误：无法更新配置文件" >&2
    exit 1
fi

echo "===== 脚本执行完成: $(date) ====="
#sudo ip link set eth0 down
#sudo ip link delete eth0
