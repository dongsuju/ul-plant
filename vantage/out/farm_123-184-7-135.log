#!/bin/bash

# 读取hostlist文件中的IP地址
mapfile -t hosts < hostlist

# 设置初始主机名索引
index=2

# 遍历IP地址，并为每台主机设置新的主机名
for host in "${hosts[@]}"; do
	new_hostname="g$(printf '%04d' "$index")"  # 生成新的主机名，如g0002、g0003等
	ssh "$host" "sudo hostnamectl set-hostname $new_hostname;sudo systemctl restart sshd"  # 通过SSH连接到远程主机，设置主机名并重启sshd服务
	((index++))  # 移动到下一个主机名索引
done
===== /root/conf/ib_write_test.sh
#!/bin/bash

# 定义节点范围，生成节点内网IP列表
start=1
end=8
node=()
for i in $(seq $start $end); do
    node="10.11.61.$i"
    nodes+=($node)
done
#nodes=(g0002 g0003 g0004 g0005 g0006 g0007 g0008 g0009 g0011 g0012 g0013 g0014 g0015 g0016)
# 设置测试命令
server_command="ib_write_bw -d mlx5_0 -x 3 -F -q 2 -a --report_gbits"
client_command="ib_write_bw -d mlx5_0 -x 3 -F -q 2 -a --report_gbits"

# 日志文件
log_file="ib_test_log.txt"
echo "IB Bandwidth Test Log" > $log_file
echo "======================" >> $log_file

# 遍历节点，进行两两测试
for (( i=0; i<${#nodes[@]}; i++ )); do
    for (( j=i+1; j<${#nodes[@]}; j++ )); do
        server_node=${nodes[i]}
        client_node=${nodes[j]}

        echo "Starting IB write bandwidth test from $client_node to $server_node..." | tee -a $log_file
        
        # 在服务端节点上执行命令
        ssh "$server_node" "$server_command" > server_output.txt 2>&1 &
        server_pid=$!

        # 等待短暂时间以确保服务端准备好
        sleep 2
        
        # 在客户端节点上执行命令
        client_output=$(ssh "$client_node" "$client_command $server_node" 2>&1)
        
        # 等待服务端命令执行完毕
        wait $server_pid
        
        # 检查是否有错误输出
        if echo "$client_output" | grep -q "error"; then
            echo "ERROR: Test failed between $client_node and $server_node" | tee -a $log_file
            echo "$client_output" | tee -a $log_file
        else
            # 记录输出结果
            echo "Server output from $server_node:" >> $log_file
            cat server_output.txt >> $log_file
            echo "Client output from $client_node:" >> $log_file
            echo "$client_output" >> $log_file
            echo "------------------------------------------------" >> $log_file
        fi

        # 清理临时文件
        rm server_output.txt
    done
done

echo "IB write bandwidth tests completed." | tee -a $log_file
