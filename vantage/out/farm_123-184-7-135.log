               -x NCCL_ALGO=Ring /data/apps/nccl-tests/build/all_reduce_perf -b 8 -e 16G -f 2 -g 1 >> $log_file 2>&1 &
        
        PID=$!
        echo "测试进程已启动，PID: $PID"
        
        # 等待当前测试完成（如果需要按顺序执行，去掉下一行的 & 符号即可）
        # wait $PID
    done
    
elif [ "$MODE" == "batch" ]; then
    # 模式2：批量测试（每64个节点一组）
