#!/bin/bash
#set -e  # 遇到错误立即退出，便于排查

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PARENT_DIR="$(dirname "$SCRIPT_DIR")"

# ================= 配置区域 =================
# 支持命令行传参：./installnvidiadriver.sh 580.105.08 或 ./installnvidiadriver.sh 580.95.05
# 未传参则使用默认版本
DRIVER_VERSION="${1:-550.163.01}"
UBUNTU_CODENAME="${2:-ubuntu2204}"  # 支持传参指定 Ubuntu 版本，默认 22.04

# 提取主版本号（如 580.105.08 -> 580，580.95.05 -> 580）
MAJOR_VERSION=$(echo "$DRIVER_VERSION" | cut -d. -f1)

# ================= 第1部分：NVIDIA驱动 =================
# 驱动下载链接格式（所有版本统一）：
# https://download.nvidia.com/XFree86/Linux-x86_64/{版本号}/NVIDIA-Linux-x86_64-{版本号}.run
DRIVER_FILE="NVIDIA-Linux-x86_64-${DRIVER_VERSION}.run"
DRIVER_URL="https://download.nvidia.com/XFree86/Linux-x86_64/${DRIVER_VERSION}/${DRIVER_FILE}"
# 备用下载地址（国内镜像）
BACKUP_DRIVER_URL="https://file.mir.blsc.cn/deploy/NVIDIA/driver/${DRIVER_FILE}"

# ================= 第2部分：nvidia-fabricmanager =================
# fabricmanager deb包命名规则：
# - 580以下版本：nvidia-fabricmanager-{主版本号}_{完整版本号}-1_amd64.deb
#   示例：nvidia-fabricmanager-550_550.90.07-1_amd64.deb
# - 580及以上版本：nvidia-fabricmanager_{完整版本号}-1_amd64.deb
#   示例：nvidia-fabricmanager_580.105.08-1_amd64.deb

if [ "$MAJOR_VERSION" -lt 580 ]; then
    # 580以下版本
    FABRIC_FILE="nvidia-fabricmanager-${MAJOR_VERSION}_${DRIVER_VERSION}-1_amd64.deb"
else
    # 580及以上版本
    FABRIC_FILE="nvidia-fabricmanager_${DRIVER_VERSION}-1_amd64.deb"
fi
FABRIC_URL="https://developer.download.nvidia.com/compute/cuda/repos/${UBUNTU_CODENAME}/x86_64/${FABRIC_FILE}"
# 备用下载地址（国内镜像）
BACKUP_FABRIC_URL="https://file.mir.blsc.cn/deploy/NVIDIA/driver/${FABRIC_FILE}"

echo "============================================"
echo "[INFO] NVIDIA Driver Version: ${DRIVER_VERSION}"
echo "[INFO] Major Version: ${MAJOR_VERSION}"
echo "[INFO] Ubuntu Codename: ${UBUNTU_CODENAME}"
echo "============================================"
echo "[INFO] Driver Primary URL:"
echo "       ${DRIVER_URL}"
echo "[INFO] Driver Backup URL:"
echo "       ${BACKUP_DRIVER_URL}"
echo "[INFO] Fabric Manager Primary URL:"
echo "       ${FABRIC_URL}"
echo "[INFO] Fabric Manager Backup URL:"
echo "       ${BACKUP_FABRIC_URL}"
echo "============================================"
# ===========================================

# ================= 智能下载函数 =================
# 功能：检测下载速度，如果低于阈值则切换备用源
# 参数：$1=主URL, $2=备用URL, $3=输出目录, $4=文件描述
smart_download() {
    local primary_url="$1"
    local backup_url="$2"
    local output_dir="$3"
    local description="$4"
    local filename=$(basename "$primary_url")
    local output_path="$output_dir/$filename"
    local speed_threshold=2000000  # 2MB/s = 2,000,000 bytes/s
    local speed_threshold_mb="2 MB/s"

    # 如果文件已存在，跳过下载
    if [ -f "$output_path" ]; then
        echo "[INFO] $description 已存在: $filename, 跳过下载。"
        return 0
    fi

    echo "[INFO] 开始下载 $description ..."
    echo "[INFO] 主地址: $primary_url"

    # 尝试从主地址下载，同时监控速度
    # 使用后台进程下载
    wget -c --timeout=30 --tries=2 -P "$output_dir" "$primary_url" 2>&1 | tee /tmp/wget_download.log &
    local wget_pid=$!

    local prev_size=0
    local check_count=0
    local max_checks=6  # 最多检查6次（30秒）

    while kill -0 $wget_pid 2>/dev/null; do
        sleep 5
        check_count=$((check_count + 1))

        # 获取当前文件大小
        local current_size=$(stat -c%s "$output_path" 2>/dev/null || echo 0)
        local speed=$(( (current_size - prev_size) / 5 ))
        local speed_kb=$((speed / 1024))

        echo "[DEBUG] 当前下载速度: ${speed_kb} KB/s ($((current_size / 1024 / 1024)) MB 已下载)"

        # 如果速度低于阈值且已检查3次以上（15秒后），切换备用源
        if [ $speed -lt $speed_threshold ] && [ $check_count -ge 3 ]; then
            echo "[WARN] 下载速度低于 ${speed_threshold_mb}，切换到备用地址..."
            echo "[INFO] 备用地址: $backup_url"

            # 终止当前下载
            kill $wget_pid 2>/dev/null || true
            wait $wget_pid 2>/dev/null || true

            # 删除不完整的文件
            rm -f "$output_path"

            # 从备用地址下载
            echo "[INFO] 正在从备用地址下载..."
            if wget -c -P "$output_dir" "$backup_url"; then
                echo "[SUCCESS] 从备用地址下载成功!"
                return 0
            else
                echo "[ERROR] 备用地址下载也失败，请检查网络连接。"
                return 1
            fi
