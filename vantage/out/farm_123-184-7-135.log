#!/bin/bash
set -eo pipefail

# ----------------------
# 配置参数
# ----------------------
REMOTE_USER="ubuntu"
REMOTE_HOST="49.235.160.237"
REMOTE_PORT="22"
SSH_KEY="/data/apps/id_rsa"

SRC_HOME="/data/DeepSeek-R1"
DEST_HOME="/data/DeepSeek-R1"
SRC_SSD_HOME="/data/DeepSeek-R1"
DEST_SSD_HOME="/data/DeepSeek-R1"

DIRECTORIES=("$SRC_SSD_HOME")            # 要同步的本地目录
REMOTE_DIRECTORIES=("$DEST_SSD_HOME")    # 对应的远程目录
NUM_PROCESSES=8                          # 并发进程数
MAX_RETRIES=3                            # 最大重试次数

# ----------------------
# 初始化变量
# ----------------------
declare -A TOTAL_SIZE                    # 总大小统计（目录名 => 字节数）
declare -A COMPLETED_SIZE                # 已完成大小统计
TMP_DIR="/tmp/rsync_parallel_$$"         # 临时目录（进程隔离）
mkdir -p "$TMP_DIR"

# ----------------------
# 工具函数
# ----------------------
# 计算目录大小（兼容空格）
calc_dir_size() {
  local dir="$1"
  du -sb "$dir" | awk '{print $1}'
}

# 带重试的 rsync 任务
rsync_with_retry() {
  local src_dir="$1"
  local dest_dir="$2"
  local exclude_list=("${@:3}")
  local retry=0
  local exit_code=0
  local progress_log="$TMP_DIR/$(basename "$src_dir").log"

  # 预处理：计算当前分块总大小
  local chunk_size=$(calc_dir_size "$src_dir")

  while [[ $retry -lt $MAX_RETRIES ]]; do
    {
      echo "========== 开始同步: $src_dir (尝试 $((retry+1)) =========="
      rsync -avz --info=progress2,stats2 --partial --append-verify --relative \
        -e "ssh -i '$SSH_KEY' -p $REMOTE_PORT" \
        "${exclude_list[@]}" \
        "$src_dir/" "$REMOTE_USER@$REMOTE_HOST:$dest_dir" 2>&1
    } | tee "$progress_log"

    exit_code=${PIPESTATUS[0]}

    # 成功时更新完成量
    if [[ $exit_code -eq 0 ]]; then
      COMPLETED_SIZE["$src_dir"]=$(( ${COMPLETED_SIZE["$src_dir"]:-0} + chunk_size ))
      return 0
    else
      echo "[错误] 同步失败 (代码 $exit_code)，10秒后重试..."
      sleep 10
      ((retry++))
    fi
  done

  echo "[严重错误] 同步 $src_dir 失败，已达最大重试次数"
  return 1
}

# ----------------------
# 主流程
# ----------------------
for idx in ${!DIRECTORIES[@]}; do
  SRC_ROOT="${DIRECTORIES[$idx]}"
  DEST_ROOT="${REMOTE_DIRECTORIES[$idx]}"

  # 步骤1: 获取子目录列表（兼容含空格名称）
  echo "正在扫描目录: $SRC_ROOT ..."
  mapfile -t SUBDIRS < <(find "$SRC_ROOT" -maxdepth 1 -mindepth 1 -type d -print0 | xargs -0 -n1 basename)

  # 步骤2: 预计算总大小
  TOTAL_SIZE["$SRC_ROOT"]=0
  for subdir in "${SUBDIRS[@]}"; do
    size=$(calc_dir_size "$SRC_ROOT/$subdir")
    TOTAL_SIZE["$SRC_ROOT"]=$(( ${TOTAL_SIZE["$SRC_ROOT"]} + size ))
  done
  echo "总需传输数据: $(numfmt --to=iec <<< ${TOTAL_SIZE["$SRC_ROOT"]})"

  # 步骤3: 分割任务
  CHUNK_SIZE=$(( ( ${#SUBDIRS[@]} + NUM_PROCESSES - 1 ) / NUM_PROCESSES ))
  for ((i=0; i<${#SUBDIRS[@]}; i+=CHUNK_SIZE)); do
    CHUNK=("${SUBDIRS[@]:i:CHUNK_SIZE}")

    # 构建排除参数
    EXCLUDE_LIST=()
    for subdir in "${SUBDIRS[@]}"; do
      if [[ ! " ${CHUNK[@]} " =~ " $subdir " ]]; then
        EXCLUDE_LIST+=("--exclude=$subdir")
      fi
    done

    # 启动后台任务
    rsync_with_retry "$SRC_ROOT" "$DEST_ROOT" "${EXCLUDE_LIST[@]}" &
  done
done

# ----------------------
# 进度监控
# ----------------------
echo "正在等待任务完成..."
while true; do
  completed=0
  total=0
===== /root/conf/trans-progress.sh
#!/bin/bash

SOURCE="/mnt"     # 源目录
DESTINATION="/data/mnt2"     # 目标目录
CHECK_INTERVAL=10              # 检查间隔（单位：秒）

# 获取源目录总大小
#TOTAL_SIZE_BYTES=$(du -sb $SOURCE | awk '{print $1}')
TOTAL_SIZE_BYTES=7972457306496
# 格式化总大小为 TB
TOTAL_SIZE_TB=$(echo "scale=2; $TOTAL_SIZE_BYTES / 1024 / 1024 / 1024 / 1024" | bc)

start_time=$(date +%s)

echo "开始传输时间: $(date)"
echo "源目录大小: ${TOTAL_SIZE_TB}TB"

while true; do
  current_time=$(date +%s)
  elapsed_time=$((current_time - start_time))

  # 获取当前已经传输的大小
  transferred_size=$(sudo du -sb $DESTINATION | awk '{print $1}')

  # 计算传输速度
  if [ $elapsed_time -gt 0 ]; then
    speed=$((transferred_size / elapsed_time))
  else
    speed=0
  fi

  # 计算传输进度和预计完成时间
  progress=$(echo "scale=2; ($transferred_size / $TOTAL_SIZE_BYTES) * 100" | bc)
  if [ $speed -gt 0 ]; then
    remaining_time=$(( (TOTAL_SIZE_BYTES - transferred_size) / speed ))
  else
    remaining_time=0
  fi

  # 格式化时间输出
  elapsed_formatted=$(printf '%02d:%02d:%02d' $((elapsed_time/3600)) $((elapsed_time%3600/60)) $((elapsed_time%60)))
  remaining_formatted=$(printf '%02d:%02d:%02d' $((remaining_time/3600)) $((remaining_time%3600/60)) $((remaining_time%60)))

  # 输出当前进度
  echo "--------------------------------"
  echo "当前时间: $(date)"
  echo "已传输: $(du -sh $DESTINATION | awk '{print $1}')"
  echo "传输速度: $(numfmt --to=iec $speed)/s"
  echo "传输进度: $progress%"
  echo "预计剩余时间: $remaining_formatted"
  echo "已经用时: $elapsed_formatted"
  echo "--------------------------------"

  sleep $CHECK_INTERVAL

  # 检查是否完成
  if (( $(echo "$progress >= 100" | bc -l) )); then
    echo "传输完成！"
    break
  fi
done

end_time=$(date +%s)
total_time=$((end_time - start_time))
total_formatted=$(printf '%02d:%02d:%02d' $((total_time/3600)) $((total_time%3600/60)) $((total_time%60)))

echo "传输完成时间: $(date)"
echo "总共用时: $total_formatted"
