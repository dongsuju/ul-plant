#!/bin/bash
set -e

echo "[INFO] 🚀 部署支持 InfiniBand 的训练容器 'fl'"

# ========== 配置区 ==========
CONTAINER_NAME="fl"
IMAGE_NAME="fl:0416"
SSH_PORT=13666

# 数据卷（请确保路径存在）
VOL_UPLOAD="/upload/test"
VOL_SHARED="/sharedata/"

# IB 驱动文件（Ubuntu 22.04 标准路径）
IB_VERBS_CONF="/etc/libibverbs.d"
IB_LIBS=(
    "/usr/lib/x86_64-linux-gnu/libibverbs.so.1"
    "/usr/lib/x86_64-linux-gnu/libmlx5.so.1"
    "/usr/lib/x86_64-linux-gnu/librdmacm.so.1"
)
# ========== 配置结束 ==========

# 检查必要文件是否存在
for lib in "${IB_LIBS[@]}"; do
    if [[ ! -f "$lib" ]]; then
        echo "[ERROR] 缺失 IB 库: $lib"
        echo "请在宿主机运行: sudo apt-get install -y rdma-core librdmacm1"
        exit 1
    fi
done

if [[ ! -d "$IB_VERBS_CONF" ]]; then
    echo "[ERROR] 缺失 IB 配置目录: $IB_VERBS_CONF"
    exit 1
fi

# 检查数据卷是否存在
if [[ ! -d "$VOL_UPLOAD" ]] || [[ ! -d "$VOL_SHARED" ]]; then
    echo "[WARN] 数据卷目录不存在，请确认路径是否正确"
    echo "  VOL_UPLOAD: $VOL_UPLOAD"
    echo "  VOL_SHARED: $VOL_SHARED"
fi

# 停止并删除旧容器（如果存在）
if docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
    echo "[INFO] ⏹️  停止旧容器 $CONTAINER_NAME..."
    docker stop "$CONTAINER_NAME" >/dev/null 2>&1 || true
    echo "[INFO] 🗑️  删除旧容器 $CONTAINER_NAME..."
    docker rm "$CONTAINER_NAME" >/dev/null 2>&1 || true
else
    echo "[INFO] 未发现旧容器 $CONTAINER_NAME，跳过删除"
fi

# 构建挂载参数
VOL_ARGS="-v ${VOL_UPLOAD}:${VOL_UPLOAD} -v ${VOL_SHARED}:${VOL_SHARED}"
IB_VOL_ARGS="-v ${IB_VERBS_CONF}:${IB_VERBS_CONF}:ro"
for lib in "${IB_LIBS[@]}"; do
    IB_VOL_ARGS="${IB_VOL_ARGS} -v ${lib}:${lib}:ro"
done

# 启动新容器
echo "[INFO] ▶️  启动新容器 $CONTAINER_NAME..."
docker run \
  --name "$CONTAINER_NAME" \
  --ipc=host \
  --network=host \
  --privileged \
  --device=/dev/infiniband \
  --cap-add=SYS_ADMIN \
  --shm-size 512g \
  --ulimit memlock=-1 \
  --gpus=all \
  -itd \
  $VOL_ARGS \
  $IB_VOL_ARGS \
  "$IMAGE_NAME" \
  /usr/sbin/sshd -D -p "$SSH_PORT"

echo ""
echo "[✅ SUCCESS] 容器 '$CONTAINER_NAME' 已启动！"
echo "  - SSH 端口: $SSH_PORT (本机)"
echo "  - 数据卷: $VOL_SHARED, $VOL_UPLOAD"
echo "  - IB 支持: 已启用 (libmlx5 + libibverbs)"
echo ""
echo "[🔧 NEXT STEP] 请确保你的 train.yaml 中包含："
echo "    NCCL_SOCKET_IFNAME: ib0"
echo "    GLOO_SOCKET_IFNAME: ib0"
