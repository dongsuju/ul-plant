# 更新软件包并安装 cpupower
sudo yum install -y kernel-tools

# 启用 cpupower
sudo systemctl enable --now cpupower.service

# 设置 CPU 频率调节模式为 "performance"
sudo cpupower frequency-set -g performance

# 确保该设置在开机时生效
echo "GOVERNOR=performance" | sudo tee /etc/sysconfig/cpupower

# 重新启动 cpupower 服务，使配置生效
sudo systemctl restart cpupower.service

# 将服务添加到开机自启
