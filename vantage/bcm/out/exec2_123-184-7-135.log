--- /root/conf/gpu_lspci_info.sh
#!/bin/bash

# 获取 GPU 的 Bus ID
bus_ids=$(nvidia-smi --query-gpu=gpu_bus_id --format=csv,noheader)

# 循环遍历每个 Bus ID 并查看详细的 lspci 信息
