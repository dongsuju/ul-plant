#!/bin/bash

# 定义节点范围
START_NODE=1
END_NODE=125

# 格式化节点名称
NODES=$(seq -f "node%03g" $START_NODE $END_NODE)

# 输出测试结果的文件
RESULT_FILE="ssh_test_results.log"
> $RESULT_FILE  # 清空旧结果

# 开始测试
echo "开始测试节点之间的 SSH 连通性..."
for NODE_A in $NODES; do
    for NODE_B in $NODES; do
        if [ "$NODE_A" != "$NODE_B" ]; then
            # 测试 SSH 连通性
            ssh -o BatchMode=yes -o ConnectTimeout=5 $NODE_A "ssh -o BatchMode=yes -o ConnectTimeout=5 $NODE_B 'echo SUCCESS'" &> /dev/null
            if [ $? -eq 0 ]; then
                echo "$NODE_A -> $NODE_B: SUCCESS" >> $RESULT_FILE
            else
                echo "$NODE_A -> $NODE_B: FAILED" >> $RESULT_FILE
            fi
        fi
    done
done


--- /root/conf/ssh.sh
#!/bin/bash
  
# 获取当前脚本的绝对路径
conf_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 获取原始调用用户
original_user="${SUDO_USER:-$USER}"

# 检查原始调用用户是否为 root
if [ "$original_user" = "root" ]; then
    # 原始调用用户是 root
    echo "user name: root"
    cp "${conf_dir}/root_rsa/sshd_config" /etc/ssh/
    cp "${conf_dir}/root_rsa/ssh_config" /etc/ssh/
else
    # 原始调用用户不是 root
    echo "user name: $original_user"
    cp "${conf_dir}/ubuntu_rsa/sshd_config" /etc/ssh/
    cp "${conf_dir}/ubuntu_rsa/ssh_config" /etc/ssh/
fi

# 重启 sshd 服务
systemctl restart sshd

