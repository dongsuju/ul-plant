--- /root/conf/acs_check.sh
for BDF in `lspci -d "*:*:*" | awk '{print $1}'`; do
  # 检查是否支持ACS
  sudo setpci -v -s ${BDF} ECAP_ACS+0x6.w > /dev/null 2>&1
  if [ $? -ne 0 ]; then
    continue
  fi
  # 读取ACS寄存器值
  acs_value=$(sudo setpci -v -s ${BDF} ECAP_ACS+0x6.w)
  echo "Device ${BDF} ACS setting: ${acs_value}"
done

