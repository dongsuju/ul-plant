#!/bin/bash

SOURCE="/mnt"     # 源目录
DESTINATION="/data/mnt2"     # 目标目录
CHECK_INTERVAL=10              # 检查间隔（单位：秒）

# 获取源目录总大小
#TOTAL_SIZE_BYTES=$(du -sb $SOURCE | awk '{print $1}')
TOTAL_SIZE_BYTES=7972457306496
# 格式化总大小为 TB
TOTAL_SIZE_TB=$(echo "scale=2; $TOTAL_SIZE_BYTES / 1024 / 1024 / 1024 / 1024" | bc)

start_time=$(date +%s)

echo "开始传输时间: $(date)"
echo "源目录大小: ${TOTAL_SIZE_TB}TB"

while true; do
  current_time=$(date +%s)
  elapsed_time=$((current_time - start_time))

  # 获取当前已经传输的大小
  transferred_size=$(sudo du -sb $DESTINATION | awk '{print $1}')

  # 计算传输速度
  if [ $elapsed_time -gt 0 ]; then
    speed=$((transferred_size / elapsed_time))
  else
    speed=0
  
