--- /root/conf/mpi.sh
#!/bin/bash

# 设置起始和结束节点编号
START_NODE=35
END_NODE=125

# 遍历节点范围，按规律执行 mpirun 命令
for i in $(seq -f "node%03g" $START_NODE $((END_NODE - 1))); do
    # 获取当前节点和下一个节点
    CURRENT_NODE=$i
    NEXT_NODE=$(printf "node%03d" $((10#${i:4} + 1))) # 自动计算下一个节点编号

    # 生成 mpirun 命令
    CMD="/gpfs01/nccl-tests/openmpi/bin/mpirun -np 2 -H ${CURRENT_NODE}:1,${NEXT_NODE}:1 hostname"
    echo "执行命令: $CMD"

    # 执行命令
    $CMD

    # 检查命令是否成功
    if [ $? -ne 0 ]; then
        echo "命令失败: $CMD"
        exit 1
    fi
done

echo "所有测试完成！"


