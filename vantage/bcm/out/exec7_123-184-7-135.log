===FILE /root/conf/hostname.sh
#!/bin/bash

# 读取hostlist文件中的IP地址
mapfile -t hosts < hostlist

# 设置初始主机名索引
index=2

# 遍历IP地址，并为每台主机设置新的主机名
for host in "${hosts[@]}"; do
	new_hostname="g$(printf '%04d' "$index")"  # 生成新的主机名，如g0002、g0003等
	ssh "$host" "sudo hostnamectl set-hostname $new_hostname;sudo systemctl restart sshd"  # 通过SSH连接到远程主机，设置主机名并重启sshd服务
	((index++))  # 移动到下一个主机名索引
done

===FILE /root/conf/change_hostname.sh
#!/bin/bash
apt-get install sshpass
# 定义主机信息
declare -A hosts=(
  ["g0018"]="172.16.10.71"
  ["g0019"]="172.16.10.72"
  ["g0020"]="172.16.10.73"
  ["g0021"]="172.16.10.74"
  ["g0022"]="172.16.10.75"
  ["g0023"]="172.16.10.76"
  ["g0024"]="172.16.10.77"
  ["g0025"]="172.16.10.78"
)

# SSH密码
PASSWORD="Beijingcs.2024"

# 遍历每个主机并修改主机名
for hostname in "${!hosts[@]}"; do
  ip="${hosts[$hostname]}"
  echo "正在修改主机 $hostname ($ip)"
  
  # 使用 sshpass 进行自动化 SSH 登录
  sshpass -p "$PASSWORD" ssh -o StrictHostKeyChecking=no root@$ip "hostnamectl set-hostname $hostname"
  
  if [ $? -eq 0 ]; then
    echo "主机 $hostname ($ip) 修改成功"
  else
    echo "主机 $hostname ($ip) 修改失败"
  fi
done

