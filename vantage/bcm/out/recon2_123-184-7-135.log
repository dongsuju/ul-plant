--- /root/conf/ubuntu_copy_id_rsa.sh
#!/bin/bash
apt-get install expect -y
apt install python3 python3-pip -y
pip3 install spawn
# 定义目标主机信息
declare -a hosts=(
  "172.16.21.11"
  "172.16.21.34"
  "172.16.21.35"
)

# SSH密码
PASSWORD="ubuntu@"

# 拷贝 .ssh 目录到每个目标主机
for ip in "${hosts[@]}"; do
  echo "正在拷贝 .ssh 目录到 $ip"
  
  expect << EOF
set timeout 20
spawn scp -r /home/ubuntu/.ssh ubuntu@$ip:/home/ubuntu
expect {
  "yes/no" { send "yes\r"; exp_continue }
  "password:" { send "$PASSWORD\r" }
}
expect eof
EOF

  if [ $? -eq 0 ]; then
    echo "成功拷贝 .ssh 目录到 $ip"
  else
    echo "拷贝 .ssh 目录到 $ip 失败"
  fi
done

