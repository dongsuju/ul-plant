#!/bin/bash

# 更新包列表并安装 cpufrequtils
sudo apt-get update
sudo apt-get install -y cpufrequtils

# 配置 cpufrequtils 设置 GOVERNOR 为 "performance"
sudo bash -c 'echo "GOVERNOR=\"performance\"" > /etc/default/cpufrequtils'

# 重启 cpufrequtils 服务
