--- /root/conf/ssh-ssh.sh
#!/bin/bash

# 定义节点范围
START_NODE=1
END_NODE=125

# 格式化节点名称
NODES=$(seq -f "node%03g" $START_NODE $END_NODE)

# 输出测试结果的文件
RESULT_FILE="ssh_test_results.log"
> $RESULT_FILE  # 清空旧结果

# 开始测试
echo "开始测试节点之间的 SSH 连通性..."
for NODE_A in $NODES; do
    for NODE_B in $NODES; do
        if [ "$NODE_A" != "$NODE_B" ]; then
            # 测试 SSH 连通性
            ssh -o BatchMode=yes -o ConnectTimeout=5 $NODE_A "ssh -o BatchMode=yes -o ConnectTimeout=5 $NODE_B 'echo SUCCESS'" &> /dev/null
            if [ $? -eq 0 ]; then
                echo "$NODE_A -> $NODE_B: SUCCESS" >> $RESULT_FILE
            else
                echo "$NODE_A -> $NODE_B: FAILED" >> $RESULT_FILE
            fi
        fi
    done
done

echo "测试完成，结果已保存到 $RESULT_FILE"

