    local remote_home="/home/$remote_user"
    local scp_user_ssh_timeout="${SCP_USER_SSH_TIMEOUT:-60}"
--- /root/conf/batch_sn.sh
#!/usr/bin/env bash
KEY=id_rsa-wqd10nbj02g1
JOBS=20
IPS=hosts.list
RESULT=result.csv

echo "hostname,ip,sn" > "$RESULT"

get_sn(){
  ip=$1
  out=$(ssh -i "$KEY" -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no root@"$ip" \
        'echo "$HOSTNAME,$(dmidecode -s system-serial-number 2>/dev/null)"' 2>/dev/null)
  if [[ $? -eq 0 && -n "$out" ]]; then
    echo "$out" | sed "s/^/$ip,/" | awk -F, '{print $2","$1","$3}'
  else
    echo "ERROR,$ip,ERROR"
  fi
}
export -f get_sn
export KEY

xargs -P "$JOBS" -I {} bash -c 'get_sn "{}"' < "$IPS" >> "$RESULT"
echo "Done! 结果见 $RESULT"

--- /root/conf/bios.sh
#!/bin/bash

echo "Checking BIOS settings..."

# 超线程检查
echo -n "Hyper-Threading: "
lscpu | grep "Thread(s) per core" | awk '{if ($4==1) print "Disabled (OK)"; else print "Enabled (Needs to be Disabled)"}'

# VT 检查
echo -n "VT (Intel Virtualization Technology): "
if grep -E "vmx|svm" /proc/cpuinfo > /dev/null; then
    echo "Enabled (Needs to be Disabled)"
else
    echo "Disabled (OK)"
fi

# APIC 检查
echo -n "APIC: "
if dmesg | grep -i apic > /dev/null; then
    echo "Enabled (Needs to be Disabled)"
else
    echo "Disabled (OK)"
fi

# VT-d 检查
echo -n "VT-d (Intel VT for Directed I/O): "
if dmesg | grep -e DMAR -e IOMMU > /dev/null; then
    echo "Enabled (Needs to be Disabled)"
else
    echo "Disabled (OK)"
fi

echo "Check completed."


