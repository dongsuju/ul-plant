--- /root/conf/rsync-local2local.sh
#!/bin/bash

# 源目录和目标目录
SRC_DIR="/data"
DEST_DIR="/backup/data"

# 设置并发进程数和最大重试次数
NUM_PROCESSES=8
MAX_RETRIES=3

# 创建临时目录
mkdir -p /tmp/rsync_lists
rm -f /tmp/rsync_lists/*

# 生成相对路径文件列表（避免绝对路径问题）
find "$SRC_DIR" -type f -printf '%P\n' > /tmp/rsync_lists/all_files.txt

# 计算总文件数量和每个进程处理量
TOTAL_FILES=$(wc -l < /tmp/rsync_lists/all_files.txt)
FILES_PER_PROCESS=$(( (TOTAL_FILES + NUM_PROCESSES - 1) / NUM_PROCESSES ))

# 分割文件列表
split -l $FILES_PER_PROCESS -d -a 2 /tmp/rsync_lists/all_files.txt /tmp/rsync_lists/rsync_list_

# 定义 rsync 任务函数（含重试逻辑）
rsync_task() {
  local list_file=$1
  local retry=0
  local exit_code=0

  while [[ $retry -lt $MAX_RETRIES ]]; do
    echo "Processing $list_file (Attempt $((retry+1))..."
    rsync -aAX --partial --progress --relative --files-from="$list_file" "$SRC_DIR/" "$DEST_DIR/"
    exit_code=$?

    # 如果 rsync 成功（退出码 0），退出循环
    if [[ $exit_code -eq 0 ]]; then
      break
    else
      echo "Attempt $((retry+1)) failed for $list_file (Exit code: $exit_code)"
     
