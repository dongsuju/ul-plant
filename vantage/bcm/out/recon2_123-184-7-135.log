--- /root/conf/docker.sh
# 更新系统包索引
sudo apt update && sudo apt upgrade -y

# 安装证书、curl、gnupg 等基础依赖
sudo apt install -y ca-certificates curl gnupg lsb-release
# 创建密钥存储目录
sudo mkdir -p /etc/apt/trusted.gpg.d

# 导入阿里云 Docker GPG 密钥（避免签名验证失败）
curl -fsSL https://mirrors.aliyun.com/docker-ce/linux/ubuntu/gpg | sudo gpg --dearmor -o /etc/apt/trusted.gpg.d/docker.gpg
# 添加适配 Ubuntu 24.04（noble）的阿里云 Docker 源
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/trusted.gpg.d/docker.gpg] https://mirrors.aliyun.com/docker-ce/linux/ubuntu $(lsb_release -cs) stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

# 再次更新包索引（加载新添加的 Docker 源）
sudo apt update
# 安装 Docker CE、Containerd、Docker Compose 插件
sudo apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
# 启动 Docker 服务
sudo systemctl start docker

# 设置开机自启
sudo systemctl enable docker

# 验证 Docker 状态（输出 active (running) 即正常）
sudo systemctl status docker


--- /root/conf/download_huggingfacemodel_B200_batch.sh
#!/bin/bash
export http_proxy=http://10.29.1.201:3128
export https_proxy=http://10.29.1.201:3128

DOWNLOAD_DIR="/ssd/models"
mkdir -p "$DOWNLOAD_DIR"

# 成功和失败计数器
success_count=0
fail_count=0
failed_models=()

download_model() {
    local url="$1"
    local model_name="$2"
    local filename=$(basename "$url")
    
    # 处理包含查询参数的URL
    if [[ "$filename" == *"?"* ]]; then
        filename=$(echo "$filename" | cut -d'?' -f1)
    fi
    
    echo "������ 开始下载: $model_name"
    echo "������ 文件: $filename"
    echo "������ URL: $url"
    echo "---"
    
    # 修复：确保 aria2c 命令在一行内完整执行
    aria2c --all-proxy="$http_proxy" --dir="$DOWNLOAD_DIR" --out="$filename" --max-tries=5 --retry-wait=10 --timeout=60 --max-connection-per-server=16 --split=16 --continue=true --check-certificate=false --summary-interval=30 "$url"
    
    if [ $? -eq 0 ]; then
        echo "✅ 成功: $model_name → $filename"
        ((success_count++))
        return 0
    else
        echo "❌ 失败: $model_name"
        ((fail_count++))
        failed_models+=("$model_name")
        return 1
    fi
    echo
}

