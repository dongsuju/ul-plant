--- /root/conf/kill_dpkg_apt.sh
#!/bin/bash

# 查找与 apt 或 dpkg 相关的进程 ID
PIDS=$(ps aux | grep -E 'apt|dpkg' | grep -v grep | awk '{print $2}')

if [ -z "$PIDS" ]; then
    echo "没有找到与 apt 或 dpkg 相关的进程。"
else
    echo "正在杀掉以下进程: $PIDS"
    # 杀掉所有相关进程
    for PID in $PIDS; do
        sudo kill -9 $PID
    done
    echo "所有相关进程已终止。"
fi

# 清理锁文件并修复包管理
echo "清理锁文件并修复包管理..."
sudo rm -f /var/lib/dpkg/lock-frontend
sudo rm -f /var/lib/dpkg/lock
sudo dpkg --configure -a
sudo apt-get install -f

echo "操作完成。"

