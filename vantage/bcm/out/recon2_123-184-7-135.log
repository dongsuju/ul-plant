--- /root/conf/clean.sh
#!/bin/bash
#Cleaning anaconda envs
# 列出所有环境名称并排除base环境和带#号的行，tail -n +3 排除表头行，从第三行开始显示，然后批量删除
for env in $(conda env list | grep -v 'base' | awk '{print $1}' | grep -v '#'); do
  conda remove --name $env --all -y
done
echo "conda envs has been clean"
#Cleaning up hidden dir and files
find . -maxdepth 1 -type d -name ".*" ! -name ".ssh" -exec rm -rf {} \;
find . -maxdepth 1 -type f -name ".*" ! -name ".ssh" -exec rm -rf {} \;
cp /etc/skel/.* .
#Cleaning up history records
history -c

