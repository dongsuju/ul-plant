--- /root/conf/cuda.sh
#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PARENT_DIR="$(dirname "$SCRIPT_DIR")"
echo "conf上一级目录路径为:$PARENT_DIR"
cuda_file=cuda_12.4.1_550.54.15_linux.run
cuda_url=https://developer.download.nvidia.com/compute/cuda/12.8.1/local_installers/cuda_12.8.1_570.124.06_linux.run

# 判断CUDA安装包是否存在，不存在则下载
if [ ! -f "$PARENT_DIR/$cuda_file" ]; then
    echo "[INFO] CUDA installer not found, downloading..."
    wget -c -P "$PARENT_DIR" "$cuda_url"
    if [ $? -ne 0 ]; then
        echo "[ERROR] Download failed, please check network or URL."
        exit 1
    fi
else
    echo "[INFO] CUDA installer already exists, skipping download."
fi

chmod +x "$PARENT_DIR/$cuda_file"
mkdir -p /usr/local/cuda-12.4

cuda_path=$PARENT_DIR
CUDA_HOME=/usr/local/cuda-12.4

$cuda_path/$cuda_file --toolkit --toolkitpath=${CUDA_HOME} --librarypath=${CUDA_HOME} --samples --samplespath=${CUDA_HOME} --tmpdir=/tmp --silent

--- /root/conf/deploy_fl_container.sh.sh
#!/bin/bash
set -e

echo "[INFO] 🚀 部署支持 InfiniBand 的训练容器 'fl'"

# ========== 配置区 ==========
CONTAINER_NAME="fl"
IMAGE_NAME="fl:0416"
SSH_PORT=13666

# 数据卷（请确保路径存在）
VOL_UPLOAD="/upload/test"
VOL_SHARED="/sharedata/"

# IB 驱动文件（Ubuntu 22.04 标准路径）
IB_VERBS_CONF="/etc/libibverbs.d"
IB_LIBS=(
    "/usr/lib/x86_64-linux-gnu/libibverbs.so.1"
    "/usr/lib/x86_64-linux-gnu/libmlx5.so.1"
    "/usr/lib/x86_64-linux-gnu/librdmacm.so.1"
)
# ========== 配置结束 ==========

# 检查必要文件是否存在
for lib in "${IB_LIBS[@]}"; do
    if [[ ! -f "$lib" ]]; then
        echo "[ERROR] 缺失 IB 库: $lib"
        echo "请在宿主机运行: sudo apt-get install -y rdma-core librdmacm1"
        exit 1
    fi
done

if [[ ! -d "$IB_VERBS_CONF" ]]; then
    echo "[ERROR] 缺失 IB 配置目录: $IB_VERBS_CONF"
    exit 1
fi

# 检查数据卷是否存在
if [[ ! -d "$VOL_UPLOAD" ]] || [[ ! -d "$VOL_SHARED" ]]; then
    echo "[WARN] 数据卷目录不存在，请确认路径是否正确"
    echo "  VOL_UPLOAD: $VOL_UPLOAD"
    echo "  VOL_SHARED: $VOL_SHARED"
fi

