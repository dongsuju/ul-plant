export LOG_DIR
export REMOTE_USER
export PARALLEL="--no-notice"

# ========== 自动安装 parallel ==========
if ! command -v parallel >/dev/null 2>&1; then
    echo "⚠️  GNU parallel 未安装，正在自动安装..."
    if sudo -n true 2>/dev/null; then
        sudo apt update -y >/dev/null 2>&1
        sudo apt install -y parallel >/dev/null 2>&1
    else
        echo "������ 需要 sudo 权限安装 parallel，请输入密码："
        sudo apt update -y
        sudo apt install -y parallel
    fi
    if ! command -v parallel >/dev/null 2>&1; then
        echo "❌ 自动安装失败，请手动运行：sudo apt install parallel"
