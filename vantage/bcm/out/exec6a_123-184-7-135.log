#!/bin/bash
apt-get install sshpass
# 定义主机信息
declare -A hosts=(
  ["g0018"]="172.16.10.71"
  ["g0019"]="172.16.10.72"
  ["g0020"]="172.16.10.73"
  ["g0021"]="172.16.10.74"
  ["g0022"]="172.16.10.75"
  ["g0023"]="172.16.10.76"
  ["g0024"]="172.16.10.77"
  ["g0025"]="172.16.10.78"
)

# SSH密码
PASSWORD="Beijingcs.2024"

# 遍历每个主机并修改主机名
for hostname in "${!hosts[@]}"; do
  ip="${hosts[$hostname]}"
  echo "正在修改主机 $hostname ($ip)"
  
  # 使用 sshpass 进行自动化 SSH 登录
  sshpass -p "$PASSWORD" ssh -o StrictHostKeyChecking=no root@$ip "hostnamectl set-hostname $hostname"
  
  if [ $? -eq 0 ]; then
    echo "主机 $hostname ($ip) 修改成功"
  else
    echo "主机 $hostname ($ip) 修改失败"
  fi
done

